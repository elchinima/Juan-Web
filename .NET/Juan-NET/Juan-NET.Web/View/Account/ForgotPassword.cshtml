@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

@await Html.PartialAsync("_StoreHeader")

<section class="auth-page">
    <div class="auth-wrap">
        <div class="auth-panel compact">
            <span class="auth-kicker">Password Help</span>
            <h1>Reset password</h1>
            <p>Enter your email and we will send a secure password reset link.</p>

            @if (TempData["AuthMessage"] is string message)
            {
                <div class="auth-alert">@message</div>
            }

            <form asp-controller="Account" asp-action="ForgotPassword" method="post" class="auth-form">
                <label>
                    Email
                    <input asp-for="Email" placeholder="email@example.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </label>
                <button class="auth-submit" type="submit">Send reset link</button>
            </form>

            <p class="auth-switch"><a asp-controller="Account" asp-action="Login">Back to login</a></p>
        </div>
    </div>
</section>
