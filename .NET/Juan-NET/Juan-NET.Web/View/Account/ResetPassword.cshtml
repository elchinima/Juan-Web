@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}

@await Html.PartialAsync("_StoreHeader")

<section class="auth-page">
    <div class="auth-wrap">
        <div class="auth-panel compact">
            <span class="auth-kicker">Secure Reset</span>
            <h1>New password</h1>
            <p>Create a new password for your Juan account.</p>

            <form asp-controller="Account" asp-action="ResetPassword" method="post" class="auth-form">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="Token" />
                <label>
                    Password
                    <input asp-for="Password" placeholder="New password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </label>
                <label>
                    Confirm password
                    <input asp-for="ConfirmPassword" placeholder="Repeat password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </label>
                <button class="auth-submit" type="submit">Change password</button>
            </form>
        </div>
    </div>
</section>
