@model LoginViewModel
@{
    ViewData["Title"] = "Login";
}

@await Html.PartialAsync("_StoreHeader")

<section class="auth-page">
    <div class="auth-wrap">
        <div class="auth-panel">
            <span class="auth-kicker">Welcome Back</span>
            <h1>Sign in</h1>
            <p>Use your Juan account to manage your profile and shopping preferences.</p>

            @if (TempData["AuthMessage"] is string message)
            {
                <div class="auth-alert">@message</div>
            }

            <a class="google-button" asp-controller="Account" asp-action="GoogleLogin">
                <span>G</span>
                Continue with Google
            </a>

            <div class="auth-divider"><span>or sign in with email</span></div>

            <form asp-controller="Account" asp-action="Login" method="post" class="auth-form">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <label>
                    Email
                    <input asp-for="Email" placeholder="email@example.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </label>
                <label>
                    Password
                    <input asp-for="Password" placeholder="Your password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </label>
                <label class="auth-check">
                    <input asp-for="RememberMe" />
                    Remember me
                </label>
                <button class="auth-submit" type="submit">Login</button>
            </form>

            <div class="auth-links">
                <a asp-controller="Account" asp-action="ForgotPassword">Forgot password?</a>
                <a asp-controller="Account" asp-action="Register">Create account</a>
            </div>
        </div>
    </div>
</section>
