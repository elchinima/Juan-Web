@model ProfileViewModel
@{
    ViewData["Title"] = "Profile";
    var initials = string.IsNullOrWhiteSpace(Model.FullName) ? "JN" : Model.FullName[..Math.Min(Model.FullName.Length, 2)].ToUpper();
}

@await Html.PartialAsync("_ProfileHeader")

<section class="profile-page">
    <div class="container">
        @if (TempData["ProfileMessage"] is string message)
        {
            <div class="auth-alert">@message</div>
        }

        <div class="profile-hero">
            <div class="profile-avatar">
                @if (!string.IsNullOrWhiteSpace(Model.ProfileImageUrl))
                {
                    <img src="@Model.ProfileImageUrl" alt="@Model.FullName" />
                }
                else
                {
                    <span>@initials</span>
                }
            </div>
            <div>
                <span class="auth-kicker">My Account</span>
                <h1>@Model.FullName</h1>
                <p>@Model.Email</p>
            </div>
            <a class="profile-secondary" asp-controller="Products" asp-action="Index">Go shopping</a>
        </div>

        <div class="profile-grid">
            <section class="profile-card">
                <h2>Profile details</h2>
                <form asp-controller="Account" asp-action="UpdateProfile" method="post" class="auth-form">
                    <input type="hidden" asp-for="UserId" />
                    <label>
                        Full name
                        <input asp-for="FullName" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </label>
                    <label>
                        Email
                        <input asp-for="Email" disabled />
                    </label>
                    <button class="auth-submit" type="submit">Save profile</button>
                </form>
            </section>

            <section class="profile-card">
                <h2>Profile image</h2>
                <form asp-controller="Account" asp-action="UploadProfileImage" method="post" enctype="multipart/form-data" class="auth-form">
                    <input type="hidden" asp-for="UserId" />
                    <div class="image-dropzone-field">
                        <span class="image-dropzone-label">Image</span>
                        <div class="image-dropzone" data-image-dropzone>
                            <input asp-for="ImageFile" type="file" accept="image/png,image/jpeg,image/jpg,image/gif" class="image-dropzone-input" data-image-input />
                            <span class="image-dropzone-text" data-image-filename>Drop image here or click to choose</span>
                            <span class="image-dropzone-hint">PNG, JPG, GIF</span>
                            <span class="image-dropzone-preview" data-image-preview aria-hidden="true">
                                <img alt="Selected image preview" />
                            </span>
                        </div>
                    </div>
                    <button class="auth-submit" type="submit">Save image</button>
                    <button class="profile-secondary profile-clear" type="button" data-image-clear disabled>Clear selection</button>
                </form>
                <form asp-controller="Account" asp-action="DeleteProfileImage" method="post" class="profile-inline-form">
                    <button class="profile-secondary" type="submit">Delete image</button>
                </form>
            </section>

        </div>
    </div>
</section>

@section Scripts {
    <script>
        (() => {
            const dropzone = document.querySelector("[data-image-dropzone]");
            if (!dropzone) {
                return;
            }

            const input = dropzone.querySelector("[data-image-input]");
            const fileName = dropzone.querySelector("[data-image-filename]");
            const preview = dropzone.querySelector("[data-image-preview]");
            const previewImg = preview ? preview.querySelector("img") : null;
            const clearButton = document.querySelector("[data-image-clear]");
            const defaultText = fileName ? fileName.textContent : "Drop image here or click to choose";
            let previewUrl = null;

            const setPreview = (file) => {
                if (previewUrl) {
                    URL.revokeObjectURL(previewUrl);
                    previewUrl = null;
                }

                if (file && previewImg) {
                    previewUrl = URL.createObjectURL(file);
                    previewImg.src = previewUrl;
                    dropzone.classList.add("has-image");
                    if (clearButton) {
                        clearButton.disabled = false;
                    }
                    if (fileName) {
                        fileName.textContent = file.name;
                        fileName.title = file.name;
                    }
                    return;
                }

                if (previewImg) {
                    previewImg.removeAttribute("src");
                }
                dropzone.classList.remove("has-image");
                if (clearButton) {
                    clearButton.disabled = true;
                }
                if (fileName) {
                    fileName.textContent = defaultText;
                    fileName.removeAttribute("title");
                }
            };

            const handleFiles = (files) => {
                if (!files || !files.length) {
                    return;
                }
                const file = files[0];
                if (file.type && !file.type.startsWith("image/")) {
                    return;
                }
                const dataTransfer = new DataTransfer();
                dataTransfer.items.add(file);
                input.files = dataTransfer.files;
                setPreview(file);
            };

            input.addEventListener("change", () => {
                const file = input.files && input.files[0];
                setPreview(file || null);
            });

            ["dragenter", "dragover"].forEach((eventName) => {
                dropzone.addEventListener(eventName, (event) => {
                    event.preventDefault();
                    event.stopPropagation();
                    dropzone.classList.add("is-dragover");
                });
            });

            ["dragleave", "dragend", "drop"].forEach((eventName) => {
                dropzone.addEventListener(eventName, (event) => {
                    event.preventDefault();
                    event.stopPropagation();
                    dropzone.classList.remove("is-dragover");
                });
            });

            dropzone.addEventListener("drop", (event) => {
                const files = event.dataTransfer ? event.dataTransfer.files : null;
                handleFiles(files);
            });

            if (clearButton) {
                clearButton.addEventListener("click", () => {
                    input.value = "";
                    setPreview(null);
                });
            }
        })();
    </script>
}
