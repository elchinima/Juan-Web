@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

@await Html.PartialAsync("_StoreHeader")

<section class="auth-page">
    <div class="auth-wrap">
        <div class="auth-panel">
            <span class="auth-kicker">Juan Account</span>
            <h1>Create account</h1>
            <p>Save your profile, secure your login, and keep checkout details ready.</p>

            @if (TempData["AuthMessage"] is string message)
            {
                <div class="auth-alert">@message</div>
            }

            <div class="social-auth">
                <a class="social-button meta" asp-controller="Account" asp-action="MetaLogin" title="Continue with Meta">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M13.75 13.45l1.05-1.72c.78-1.27 1.42-2 2.4-2 1.16 0 1.9.98 1.9 2.63 0 1.56-.68 2.5-1.8 2.5-.9 0-1.46-.48-2.55-1.41zm-.74-1.2l-.92-1.5c-1.2-1.96-2.25-2.92-3.84-2.92C5.94 7.83 4 10 4 12.86c0 2.78 1.74 4.64 4.12 4.64 1.66 0 2.85-.78 4.15-3l.74-1.25zm-1.69.3l-.55.94c-.98 1.66-1.6 2.08-2.55 2.08-1.22 0-2.07-1.06-2.07-2.7 0-1.72.92-3.02 2.07-3.02.93 0 1.55.62 2.5 2.08l.6.62zm3.1 2.2c1.18 1.4 1.98 2.75 3.03 2.75 2.37 0 3.97-1.85 3.97-4.68 0-2.95-1.7-4.99-4.1-4.99-1.65 0-2.78 1-4.1 3.12l-.23.38.89 1.45.54-.9c1.08-1.78 1.68-2.03 2.55-2.03 1.17 0 2.05 1.21 2.05 3 0 1.6-.72 2.72-1.78 2.72-.72 0-1.15-.38-2.32-1.92l-.5 1.1z"/></svg>
                    <span>Meta</span>
                </a>
                <a class="social-button google" asp-controller="Account" asp-action="GoogleLogin" title="Continue with Google">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M21.6 12.23c0-.78-.07-1.53-.2-2.23H12v4.22h5.38a4.6 4.6 0 0 1-2 3.02v2.52h3.24c1.9-1.75 2.98-4.32 2.98-7.53z"/><path fill="#34A853" d="M12 22c2.7 0 4.96-.9 6.62-2.44l-3.24-2.52c-.9.6-2.04.96-3.38.96-2.6 0-4.8-1.76-5.59-4.12H3.06v2.6A10 10 0 0 0 12 22z"/><path fill="#FBBC05" d="M6.41 13.88A6 6 0 0 1 6.1 12c0-.65.11-1.28.31-1.88v-2.6H3.06A10 10 0 0 0 2 12c0 1.61.39 3.14 1.06 4.48l3.35-2.6z"/><path fill="#EA4335" d="M12 6c1.47 0 2.78.5 3.82 1.5l2.87-2.87A9.65 9.65 0 0 0 12 2a10 10 0 0 0-8.94 5.52l3.35 2.6C7.2 7.76 9.4 6 12 6z"/></svg>
                    <span>Google</span>
                </a>
                <a class="social-button x" asp-controller="Account" asp-action="XLogin" title="Continue with X">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M18.9 2.5h3.3l-7.2 8.23 8.47 11.2h-6.63l-5.2-6.79-5.94 6.79H2.4l7.7-8.8L2 2.5h6.8l4.7 6.22 5.4-6.22zm-1.16 17.46h1.83L7.8 4.36H5.84l11.9 15.6z"/></svg>
                    <span>X</span>
                </a>
            </div>

            <div class="auth-divider"><span>or register with email</span></div>

            <form asp-controller="Account" asp-action="Register" method="post" class="auth-form">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <label>
                    Full name
                    <input asp-for="FullName" placeholder="Your name" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </label>
                <label>
                    Email
                    <input asp-for="Email" placeholder="email@example.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </label>
                <label>
                    Password
                    <input asp-for="Password" placeholder="Create password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </label>
                <label>
                    Confirm password
                    <input asp-for="ConfirmPassword" placeholder="Repeat password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </label>
                <button class="auth-submit" type="submit">Register</button>
            </form>

            <p class="auth-switch">Already have an account? <a asp-controller="Account" asp-action="Login">Sign in</a></p>
        </div>
    </div>
</section>
