@model AdminSubscribeViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Subscribe";
    ViewData["PageName"] = "subscribe";
    ViewData["ActivePage"] = "Subscribe";
    var recipients = Model.Subscribers.Select(subscriber => subscriber.Email)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(email => email)
        .ToList();
    var userSearch = Model.UserSearch ?? string.Empty;
}

@section SidebarCard {
    <span>Email</span>
    <strong>@recipients.Count Subscribers</strong>
    <p>Newsletter delivery for subscribed emails.</p>
}

<header class="topbar">
    <button class="menu-button" type="button" aria-label="Toggle menu" data-menu-toggle>
        <span></span><span></span><span></span>
    </button>
    <div>
        <p class="eyebrow">Email</p>
        <h1>Subscribe</h1>
    </div>
    <div class="topbar-actions">
        <button class="primary-button" type="button" data-open-subscribe-modal>Send Message</button>
        <a class="ghost-button" asp-controller="Admin" asp-action="Index">Dashboard</a>
    </div>
</header>

@if (TempData["SubscribeMessage"] is string message)
{
    <div class="status good admin-message">@message</div>
}

<section class="panel reveal subscribe-panel">
        <div class="panel-head">
            <div>
                <p class="eyebrow">Recipients</p>
                <h3>Subscribers</h3>
            </div>
            <form class="admin-search-form subscribe-search" asp-controller="Admin" asp-action="Subscribe" method="get">
                <input name="userSearch" value="@userSearch" placeholder="Search subscriber email" />
                <button class="primary-button" type="submit">Search</button>
                @if (!string.IsNullOrWhiteSpace(userSearch))
                {
                    <a class="ghost-button" asp-controller="Admin" asp-action="Subscribe">Reset</a>
                }
            </form>
        </div>
        <div class="subscribe-toolbar">
            <span>Select subscribers, then send a message or image-rich update.</span>
            <button class="primary-button" type="button" data-open-subscribe-modal>Compose</button>
        </div>
        <div class="admin-table subscribe-table">
            <div class="admin-table-head">
                <span>Email</span>
                <span>Created</span>
                <span>Status</span>
                <span>Selected</span>
            </div>
            @if (recipients.Any())
            {
                @foreach (var subscriber in Model.Subscribers)
                {
                    var email = subscriber.Email;
                    <label class="admin-table-row subscribe-row" form="subscribe-send-form">
                        <strong>@email</strong>
                        <span>@subscriber.CreatedAt.ToString("MMM dd, yyyy")</span>
                        <span class="status good">Ready</span>
                        <input type="checkbox" name="SelectedEmails" value="@email" form="subscribe-send-form" checked="@Model.SelectedEmails.Contains(email, StringComparer.OrdinalIgnoreCase)" />
                    </label>
                }
            }
            else
            {
                <div class="admin-table-row">
                    <strong>No recipients yet</strong>
                    <span>-</span>
                    <span class="status off">Empty</span>
                    <span>-</span>
                </div>
            }
        </div>
</section>

<div class="admin-modal @(ViewData.ModelState.IsValid ? "" : "is-open")" data-subscribe-modal>
    <div class="admin-modal-backdrop" data-close-subscribe-modal></div>
    <section class="admin-modal-panel" role="dialog" aria-modal="true" aria-labelledby="subscribe-modal-title">
        <div class="panel-head">
            <div>
                <p class="eyebrow">Delivery</p>
                <h3 id="subscribe-modal-title">Send Message</h3>
            </div>
            <button class="modal-close" type="button" aria-label="Close modal" data-close-subscribe-modal>&times;</button>
        </div>
        <form id="subscribe-send-form" class="admin-form" asp-controller="Admin" asp-action="SendSubscribe" method="post" enctype="multipart/form-data" data-confirm="Send this message to selected recipients?">
            <input asp-for="UserSearch" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="status off"></div>
            <span asp-validation-for="SelectedEmails" class="status off"></span>
            <label>
                Subject
                <input asp-for="Subject" placeholder="New Juan update" />
                <span asp-validation-for="Subject" class="status off"></span>
            </label>
            <label>
                Message
                <textarea asp-for="Message" rows="7" placeholder="Write message text"></textarea>
                <span asp-validation-for="Message" class="status off"></span>
            </label>
            <label class="image-picker">
                Image
                <input asp-for="ImageFile" type="file" accept="image/*" />
                <span>Choose newsletter image</span>
                <span asp-validation-for="ImageFile" class="status off"></span>
            </label>
            <button class="primary-button full" type="submit">Send Message</button>
        </form>
    </section>
</div>
