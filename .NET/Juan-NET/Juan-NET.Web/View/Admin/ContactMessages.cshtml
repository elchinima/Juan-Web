@model List<ContactMessage>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Messages";
    ViewData["PageName"] = "messages";
    ViewData["ActivePage"] = "ContactMessages";
    var search = ViewBag.ContactSearch as string ?? string.Empty;
    var canDeleteMessages = ViewBag.CanDeleteMessages as bool? ?? false;
    var statuses = new[] { "New", "In Progress", "Resolved", "Closed" };
}

@section SidebarCard {
    <span>Contact</span>
    <strong>@Model.Count Messages</strong>
    <p>Customer messages submitted from Contact Us.</p>
}

<header class="topbar">
    <button class="menu-button" type="button" aria-label="Toggle menu" data-menu-toggle>
        <span></span><span></span><span></span>
    </button>
    <div>
        <p class="eyebrow">Inbox</p>
        <h1>Messages</h1>
    </div>
    <div class="topbar-actions">
        <a class="ghost-button" asp-controller="Admin" asp-action="Index">Dashboard</a>
    </div>
</header>

@if (TempData["ContactMessageAdminMessage"] is string adminMessage)
{
    <div class="status good admin-message">@adminMessage</div>
}

<section class="panel reveal">
    <div class="panel-head">
        <div>
            <p class="eyebrow">Contact Us</p>
            <h3>Customer Messages</h3>
        </div>
        <form class="admin-search-form" asp-controller="Admin" asp-action="ContactMessages" method="get">
            <input name="search" value="@search" placeholder="Search name, email or message" />
            <button class="primary-button" type="submit">Search</button>
            @if (!string.IsNullOrWhiteSpace(search))
            {
                <a class="ghost-button" asp-controller="Admin" asp-action="ContactMessages">Reset</a>
            }
        </form>
    </div>

    <div class="message-list">
        @if (Model.Any())
        {
            @foreach (var message in Model)
            {
                <article class="message-card">
                    <div>
                        <strong>@message.Name</strong>
                        <a href="mailto:@message.Email">@message.Email</a>
                    </div>
                    <p>@message.Message</p>
                    <div class="message-meta">
                        <span>Created: @message.CreatedAt.ToString("MMM dd, yyyy HH:mm")</span>
                        <span>Status: @message.Status</span>
                        @if (!string.IsNullOrWhiteSpace(message.StatusChangedByEmail) && message.StatusChangedAt.HasValue)
                        {
                            <span>Changed by @message.StatusChangedByEmail at @message.StatusChangedAt.Value.ToString("MMM dd, yyyy HH:mm")</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(message.AdminNote))
                        {
                            <span>Note: @message.AdminNote</span>
                        }
                    </div>
                    <form class="message-admin-form" asp-controller="Admin" asp-action="UpdateContactMessage" method="post">
                        <input type="hidden" name="id" value="@message.Id" />
                        <input type="hidden" name="search" value="@search" />
                        <label>
                            Status
                            <select name="status">
                                @foreach (var status in statuses)
                                {
                                    <option value="@status" selected="@(message.Status == status)">@status</option>
                                }
                            </select>
                        </label>
                        <label>
                            Note
                            <input name="adminNote" value="@message.AdminNote" maxlength="100" />
                        </label>
                        <button class="primary-button compact-button" type="submit">Save</button>
                    </form>
                    @if (canDeleteMessages)
                    {
                        <form asp-controller="Admin" asp-action="DeleteContactMessage" method="post" data-confirm="Delete this message?">
                            <input type="hidden" name="id" value="@message.Id" />
                            <input type="hidden" name="search" value="@search" />
                            <button class="danger-button compact-button" type="submit">Delete</button>
                        </form>
                    }
                </article>
            }
        }
        else
        {
            <article class="message-card">
                <div>
                    <strong>No messages found</strong>
                    <a asp-controller="Home" asp-action="Contact">Contact Us</a>
                </div>
                <p>@(string.IsNullOrWhiteSpace(search) ? "New Contact Us submissions will appear here." : "Try another search term.")</p>
                <span>-</span>
            </article>
        }
    </div>
</section>
