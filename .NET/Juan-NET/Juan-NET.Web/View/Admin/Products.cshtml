@model AdminProductsViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Products";
    ViewData["PageName"] = "products";
    ViewData["ActivePage"] = "Products";
    var lowStock = Model.Products.Count(product => product.StockCount <= 5);
    var selectedCategoryIds = Model.SelectedCategoryIds;
    var openEditProductModal = ViewData["OpenEditProductModal"] as bool? == true;
    var editProductPrice = Model.Product.Price.ToString(CultureInfo.InvariantCulture);
    var search = Model.Search ?? string.Empty;
}

@section SidebarCard {
    <span>Catalog</span>
    <strong>@Model.Products.Count Items</strong>
    <p>@lowStock products need a stock review.</p>
}

<header class="topbar">
    <button class="menu-button" type="button" aria-label="Toggle menu" data-menu-toggle>
        <span></span><span></span><span></span>
    </button>
    <div>
        <p class="eyebrow">Catalog</p>
        <h1>Products</h1>
    </div>
    <div class="topbar-actions">
        <a class="ghost-button" asp-controller="Admin" asp-action="Index">Dashboard</a>
        <button class="primary-button" type="button" data-open-product-modal>Add Product</button>
    </div>
</header>

<section class="hero-panel reveal">
    <div>
        <p class="eyebrow">Inventory</p>
        <h2>Add products to the database and publish them to the storefront.</h2>
        <p>New items saved here are stored in the Products table and shown on the shop page.</p>
    </div>
    <div class="hero-metric">
        <span>Low Stock</span>
        <strong data-count="@lowStock">0</strong>
        <small>Review needed</small>
    </div>
</section>

@if (TempData["ProductMessage"] is string message)
{
    <div class="status good admin-message">@message</div>
}

<section class="panel reveal">
    <div class="panel-head">
        <div>
            <p class="eyebrow">Products</p>
            <h3>Catalog List</h3>
        </div>
        <form class="admin-search-form" asp-controller="Admin" asp-action="Products" method="get">
            <input name="search" value="@search" placeholder="Search product or category" />
            <button class="primary-button" type="submit">Search</button>
            @if (!string.IsNullOrWhiteSpace(search))
            {
                <a class="ghost-button" asp-controller="Admin" asp-action="Products">Reset</a>
            }
        </form>
    </div>
    <div class="product-list">
        @if (Model.Products.Any())
        {
            @foreach (var product in Model.Products)
            {
                <div class="product-row">
                    <div class="product-thumb">@product.Name[..Math.Min(product.Name.Length, 2)].ToUpper()</div>
                    <div><strong>@product.Name</strong><span>@string.Join(", ", product.ProductCategories.Select(productCategory => productCategory.Category.Name))</span></div>
                    <em>@product.Price.ToString("C")</em>
                    <small class="status @(product.IsActive ? (product.StockCount <= 5 ? "warn" : "good") : "off")">@(product.IsActive ? (product.StockCount <= 5 ? "Low Stock" : "In Stock") : "Draft")</small>
                    <button class="ghost-button compact-button" type="button"
                            data-open-edit-product-modal
                            data-product-id="@product.Id"
                            data-product-name="@product.Name"
                            data-product-price="@product.Price.ToString(CultureInfo.InvariantCulture)"
                            data-product-stock="@product.StockCount"
                            data-product-image="@product.ImageUrl"
                            data-product-description="@product.Description"
                            data-product-active="@product.IsActive.ToString().ToLowerInvariant()"
                            data-product-categories="@string.Join(",", product.ProductCategories.Select(productCategory => productCategory.CategoryId))">
                        Edit
                    </button>
                    <form asp-controller="Admin" asp-action="DeleteProduct" method="post" data-confirm="Delete this product?">
                        <input type="hidden" name="id" value="@product.Id" />
                        <button class="danger-button" type="submit">Delete</button>
                    </form>
                </div>
            }
        }
        else
        {
                <div class="product-row">
                    <div class="product-thumb">JN</div>
                    <div><strong>No products found</strong><span>@(string.IsNullOrWhiteSpace(search) ? "Create the first item using the Add Product button." : "Try another search term.")</span></div>
                    <em>$0.00</em>
                    <small class="status off">Empty</small>
                </div>
        }
    </div>
</section>

<div class="admin-modal @(!ViewData.ModelState.IsValid && !openEditProductModal ? "is-open" : "")" data-product-modal>
    <div class="admin-modal-backdrop" data-close-product-modal></div>
    <section class="admin-modal-panel" role="dialog" aria-modal="true" aria-labelledby="product-modal-title">
        <div class="panel-head">
            <div>
                <p class="eyebrow">Create</p>
                <h3 id="product-modal-title">Add Product</h3>
            </div>
            <button class="modal-close" type="button" aria-label="Close modal" data-close-product-modal>&times;</button>
        </div>

        <form class="admin-form two-column" asp-controller="Admin" asp-action="AddProduct" method="post" enctype="multipart/form-data" data-confirm="Save this product?">
            <div asp-validation-summary="ModelOnly" class="status off form-wide"></div>
            <label>
                Product Name
                <input asp-for="Product.Name" placeholder="Running Sneakers" />
                <span asp-validation-for="Product.Name" class="status off"></span>
            </label>
            <label>
                Price
                <input asp-for="Product.Price" type="number" step="0.01" placeholder="88.00" />
                <span asp-validation-for="Product.Price" class="status off"></span>
            </label>
            <label>
                Stock Count
                <input asp-for="Product.StockCount" type="number" min="0" placeholder="25" />
                <span asp-validation-for="Product.StockCount" class="status off"></span>
            </label>
            <label class="image-picker">
                Image
                <input asp-for="ImageFile" type="file" accept="image/*" data-image-input />
                <span data-image-name>Choose product image</span>
            </label>
            <div class="category-picker form-wide">
                <span>Category</span>
                <div>
                    @foreach (var category in Model.Categories)
                    {
                        <label>
                            <input type="checkbox" name="SelectedCategoryIds" value="@category.Id" checked="@selectedCategoryIds.Contains(category.Id)" data-category-choice />
                            @category.Name
                        </label>
                    }
                </div>
                <span asp-validation-for="SelectedCategoryIds" class="status off"></span>
            </div>
            <label class="form-wide">
                Description
                <textarea asp-for="Product.Description" rows="4" placeholder="Short product description"></textarea>
            </label>
            <label class="inline-check form-wide">
                <input asp-for="Product.IsActive" checked />
                Publish product
            </label>
            <button class="primary-button full form-wide" type="submit" data-pulse>Save Product</button>
        </form>
    </section>
</div>

<div class="admin-modal @(openEditProductModal ? "is-open" : "")" data-edit-product-modal>
    <div class="admin-modal-backdrop" data-close-edit-product-modal></div>
    <section class="admin-modal-panel" role="dialog" aria-modal="true" aria-labelledby="edit-product-modal-title">
        <div class="panel-head">
            <div>
                <p class="eyebrow">Edit</p>
                <h3 id="edit-product-modal-title">Edit Product</h3>
            </div>
            <button class="modal-close" type="button" aria-label="Close modal" data-close-edit-product-modal>&times;</button>
        </div>

        <form class="admin-form two-column" asp-controller="Admin" asp-action="EditProduct" method="post" enctype="multipart/form-data" data-confirm="Save product changes?">
            <input name="Product.Id" value="@Model.Product.Id" type="hidden" data-edit-product-id />
            <input name="Product.ImageUrl" value="@Model.Product.ImageUrl" type="hidden" data-edit-product-image />
            <div asp-validation-summary="ModelOnly" class="status off form-wide"></div>
            <label>
                Product Name
                <input name="Product.Name" value="@Model.Product.Name" placeholder="Running Sneakers" data-edit-product-name />
                <span asp-validation-for="Product.Name" class="status off"></span>
            </label>
            <label>
                Price
                <input name="Product.Price" value="@editProductPrice" type="number" step="0.01" placeholder="88.00" data-edit-product-price />
                <span asp-validation-for="Product.Price" class="status off"></span>
            </label>
            <label>
                Stock Count
                <input name="Product.StockCount" value="@Model.Product.StockCount" type="number" min="0" placeholder="25" data-edit-product-stock />
                <span asp-validation-for="Product.StockCount" class="status off"></span>
            </label>
            <label class="image-picker">
                Image
                <input name="ImageFile" type="file" accept="image/*" data-edit-image-input />
                <span data-edit-image-name>Keep current image</span>
            </label>
            <div class="category-picker form-wide">
                <span>Category</span>
                <div>
                    @foreach (var category in Model.Categories)
                    {
                        <label>
                            <input type="checkbox" name="SelectedCategoryIds" value="@category.Id" checked="@selectedCategoryIds.Contains(category.Id)" data-edit-category-choice />
                            @category.Name
                        </label>
                    }
                </div>
                <span asp-validation-for="SelectedCategoryIds" class="status off"></span>
            </div>
            <label class="form-wide">
                Description
                <textarea name="Product.Description" rows="4" placeholder="Short product description" data-edit-product-description>@Model.Product.Description</textarea>
            </label>
            <label class="inline-check form-wide">
                <input name="Product.IsActive" value="true" type="checkbox" checked="@Model.Product.IsActive" data-edit-product-active />
                <input name="Product.IsActive" value="false" type="hidden" />
                Publish product
            </label>
            <button class="primary-button full form-wide" type="submit">Save Changes</button>
        </form>
    </section>
</div>
