@model AdminCategoriesViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Categories";
    ViewData["PageName"] = "categories";
    ViewData["ActivePage"] = "Categories";
}

@section SidebarCard {
    <span>Catalog</span>
    <strong>@Model.Categories.Count Categories</strong>
    <p>Product category groups from the database.</p>
}

<header class="topbar">
    <button class="menu-button" type="button" aria-label="Toggle menu" data-menu-toggle>
        <span></span><span></span><span></span>
    </button>
    <div>
        <p class="eyebrow">Catalog</p>
        <h1>Categories</h1>
    </div>
    <div class="topbar-actions">
        <a class="ghost-button" asp-controller="Admin" asp-action="Index">Dashboard</a>
    </div>
</header>

@if (TempData["CategoryMessage"] is string message)
{
    <div class="status good admin-message">@message</div>
}

<section class="content-grid wide-left">
    <article class="panel reveal">
        <div class="panel-head">
            <div>
                <p class="eyebrow">Categories</p>
                <h3>Category List</h3>
            </div>
        </div>
        <div class="admin-table categories-table">
            <div class="admin-table-head">
                <span>ID</span>
                <span>Name</span>
                <span>Products</span>
                <span>Action</span>
            </div>
            @if (Model.Categories.Any())
            {
                @foreach (var category in Model.Categories)
                {
                    <div class="admin-table-row">
                        <em>#@category.Id</em>
                        <strong>@category.Name</strong>
                        <span>@category.ProductCategories.Count</span>
                        <form asp-controller="Admin" asp-action="DeleteCategory" method="post" data-confirm="Delete this category?">
                            <input type="hidden" name="id" value="@category.Id" />
                            <button class="danger-button" type="submit">Delete</button>
                        </form>
                    </div>
                }
            }
            else
            {
                <div class="admin-table-row">
                    <em>#0</em>
                    <strong>No categories yet</strong>
                    <span>0</span>
                    <span>-</span>
                </div>
            }
        </div>
    </article>

    <article class="panel reveal">
        <div class="panel-head">
            <div>
                <p class="eyebrow">Create</p>
                <h3>Add Category</h3>
            </div>
        </div>
        <form class="admin-form" asp-controller="Admin" asp-action="AddCategory" method="post" data-confirm="Save this category?">
            <div asp-validation-summary="ModelOnly" class="status off"></div>
            <label>
                Category Name
                <input asp-for="Category.Name" placeholder="Sneakers" />
                <span asp-validation-for="Category.Name" class="status off"></span>
            </label>
            <button class="primary-button full" type="submit">Save Category</button>
        </form>
    </article>
</section>
