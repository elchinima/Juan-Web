@model AdminUsersViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Users";
    ViewData["PageName"] = "customers";
    ViewData["ActivePage"] = "Users";
    var search = Model.Search ?? string.Empty;
}

@section SidebarCard {
    <span>Audience</span>
    <strong>@Model.Users.Count Users</strong>
    <p>Registered customers from the Users table.</p>
}

<header class="topbar">
    <button class="menu-button" type="button" aria-label="Toggle menu" data-menu-toggle>
        <span></span><span></span><span></span>
    </button>
    <div>
        <p class="eyebrow">People</p>
        <h1>Customers</h1>
    </div>
    <div class="topbar-actions">
        <a class="ghost-button" asp-controller="Admin" asp-action="Roles">Roles</a>
        <a class="primary-button" asp-controller="Account" asp-action="Register">Register User</a>
    </div>
</header>

<section class="panel reveal">
    <div class="panel-head">
        <div>
            <p class="eyebrow">Users</p>
            <h3>Registered Customers</h3>
        </div>
        <form class="admin-search-form" asp-controller="Admin" asp-action="Users" method="get">
            <input name="search" value="@search" placeholder="Search name or email" />
            <button class="primary-button" type="submit">Search</button>
            @if (!string.IsNullOrWhiteSpace(search))
            {
                <a class="ghost-button" asp-controller="Admin" asp-action="Users">Reset</a>
            }
        </form>
    </div>
    <div class="admin-table users-table">
        <div class="admin-table-head">
            <span>ID</span>
            <span>Full Name</span>
            <span>Email</span>
            <span>Roles</span>
            <span>Created</span>
        </div>
        @if (Model.Users.Any())
        {
            @foreach (var user in Model.Users)
            {
                <div class="admin-table-row">
                    <em>#@user.Id</em>
                    <strong>@user.FullName</strong>
                    <span>@user.Email</span>
                    <span class="role-chip-list">
                        @if (user.AdminRoles.Any())
                        {
                            var highestRole = user.AdminRoles.OrderBy(item => item.AdminRole.DisplayOrder).ThenBy(item => item.AdminRole.Name).First();
                            var extraRoleCount = user.AdminRoles.Count - 1;
                            <span class="role-chip" style="--role-color: @highestRole.AdminRole.Color">@highestRole.AdminRole.Name</span>
                            @if (extraRoleCount > 0)
                            {
                                <span class="role-chip extra-role-count">+@extraRoleCount</span>
                            }
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </span>
                    <span>@user.CreatedAt.ToString("MMM dd, yyyy")</span>
                </div>
            }
        }
        else
        {
            <div class="admin-table-row">
                <em>#0</em>
                <strong>No users yet</strong>
                <span>Registration data will appear here.</span>
                <span>-</span>
                <span>-</span>
            </div>
        }
    </div>
</section>
