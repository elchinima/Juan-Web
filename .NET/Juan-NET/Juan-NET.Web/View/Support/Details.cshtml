@model SupportTicketDetailsViewModel
@{
    Layout = "_SupportLayout";
    ViewData["Title"] = Model.Code;
    ViewData["PageName"] = "support-report-details";
    ViewData["ActivePage"] = "History";
}

@section SidebarCard {
    <span>@Model.Status</span>
    <strong>@Model.Code</strong>
    <p>@Model.CreatedAt.ToString("MMM d, yyyy HH:mm")</p>
}

<header class="topbar">
    <button class="menu-button" type="button" aria-label="Toggle menu" data-menu-toggle>
        <span></span><span></span><span></span>
    </button>
    <div>
        <p class="eyebrow">@Model.Customer</p>
        <h1>@Model.Subject</h1>
    </div>
    <div class="topbar-actions">
        <a class="ghost-button" asp-controller="Support" asp-action="History">Report History</a>
    </div>
</header>

<section class="panel reveal support-ticket-panel">
    <div class="panel-head">
        <div>
            <p class="eyebrow">@Model.Code · @Model.Topic</p>
            <h3>@Model.Subject</h3>
        </div>
        <em class="status-pill">@Model.Status</em>
    </div>

    @if (Model.Rating.HasValue)
    {
        <div class="support-rating-summary">
            <strong>@Model.Rating.Value.ToString("0.0", CultureInfo.InvariantCulture)</strong>
            @if (!string.IsNullOrWhiteSpace(Model.RatingComment))
            {
                <p>@Model.RatingComment</p>
            }
        </div>
    }

    <div class="support-chat-messages support-admin-messages">
        @foreach (var message in Model.Messages)
        {
            <article class="support-chat-message @(message.IsOperator ? "agent" : "user")">
                <strong>@message.SenderName</strong>
                @if (!string.IsNullOrWhiteSpace(message.Text))
                {
                    <p>@message.Text</p>
                }
                @if (!string.IsNullOrWhiteSpace(message.ImageUrl))
                {
                    <a class="support-chat-attachment" href="@message.ImageUrl" target="_blank" rel="noopener">
                        <img src="@message.ImageUrl" alt="Support attachment" />
                    </a>
                }
            </article>
        }
    </div>
</section>
