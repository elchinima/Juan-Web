@model IReadOnlyList<SupportReportViewModel>
@{
    Layout = "_SupportLayout";
    ViewData["Title"] = "Reports";
    ViewData["PageName"] = "support-reports";
    ViewData["ActivePage"] = "Reports";
}

@section SidebarCard {
    <span>Queue</span>
    <strong>@Model.Count(item => item.Status != "Resolved")</strong>
    <p>Reports waiting for support action.</p>
}

<header class="topbar">
    <button class="menu-button" type="button" aria-label="Toggle menu" data-menu-toggle>
        <span></span><span></span><span></span>
    </button>
    <div>
        <p class="eyebrow">Technical Support</p>
        <h1>Reports</h1>
    </div>
    <div class="topbar-actions">
        @if (ViewBag.ActiveReportId is not null)
        {
            <a class="primary-button" asp-controller="Support" asp-action="ActiveReport">Active Report</a>
        }
        <a class="ghost-button" asp-controller="Support" asp-action="Index">Dashboard</a>
    </div>
</header>

<section class="panel reveal">
    <div class="panel-head">
        <div>
            <p class="eyebrow">Live queue</p>
            <h3>Incoming Reports</h3>
        </div>
    </div>
    <div class="support-table">
        <div class="support-table-head">
            <span>Code</span>
            <span>Customer</span>
            <span>Category</span>
            <span>Priority</span>
            <span>Status</span>
            <span>Action</span>
        </div>
        <div data-support-token-source hidden>
            @Html.AntiForgeryToken()
        </div>
        <div data-support-report-queue data-support-report-queue-url="@Url.Action("ReportQueue", "Support")" data-support-take-url="@Url.Action("Take", "Support")" data-support-has-active-report="@(ViewBag.ActiveReportId is not null ? "true" : "false")">
            @foreach (var report in Model)
            {
                <article class="support-table-row">
                    <span>@report.Code</span>
                    <strong>@report.Customer</strong>
                    <p>@report.Topic</p>
                    <em class="priority-pill @report.Priority.ToLowerInvariant()">@report.Priority</em>
                    <em class="status-pill">@report.Status</em>
                    <form asp-controller="Support" asp-action="Take" asp-route-id="@report.Id" method="post">
                        @Html.AntiForgeryToken()
                        @if (ViewBag.ActiveReportId is not null)
                        {
                            <button class="primary-button compact-button" type="submit" disabled>Take</button>
                        }
                        else
                        {
                            <button class="primary-button compact-button" type="submit">Take</button>
                        }
                    </form>
                </article>
            }
            @if (!Model.Any())
            {
                <article class="support-table-row" data-support-empty-row>
                    <span>No reports</span>
                    <strong>Queue is empty</strong>
                    <p>New reports will appear here.</p>
                    <em class="priority-pill low">Low</em>
                    <em class="status-pill">Open</em>
                    <time>@DateTime.UtcNow.ToString("HH:mm")</time>
                </article>
            }
        </div>
    </div>
</section>
