@model SupportTicketDetailsViewModel
@{
    Layout = "_SupportLayout";
    ViewData["Title"] = "Active Report";
    ViewData["PageName"] = "support-active-report";
    ViewData["ActivePage"] = "ActiveReport";
}

@section SidebarCard {
    <span>@Model.Status</span>
    <strong>@Model.Code</strong>
    <p>@Model.CreatedAt.ToString("MMM d, yyyy HH:mm")</p>
}

<header class="topbar">
    <button class="menu-button" type="button" aria-label="Toggle menu" data-menu-toggle>
        <span></span><span></span><span></span>
    </button>
    <div>
        <p class="eyebrow">@Model.Customer</p>
        <h1>Active Report</h1>
    </div>
    <div class="topbar-actions">
        <form asp-controller="Support" asp-action="Close" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <button class="danger-button" type="submit">Close Report</button>
        </form>
        <a class="ghost-button" asp-controller="Support" asp-action="Reports">Reports</a>
    </div>
</header>

<section class="panel reveal support-ticket-panel support-operator-chat-panel">
    <div class="panel-head">
        <div>
            <p class="eyebrow">@Model.Code</p>
            <h3>@Model.Subject</h3>
        </div>
        <em class="status-pill">@Model.Status</em>
    </div>

    <div class="support-chat-messages support-admin-messages" data-support-messages data-support-chat-poll="@Url.Action("ActiveReportMessages", "Support")" data-support-inactive-url="@Url.Action("Reports", "Support")">
        @foreach (var message in Model.Messages)
        {
            <article class="support-chat-message @(message.IsOperator ? "agent" : "user")">
                <strong>@message.SenderName</strong>
                @if (!string.IsNullOrWhiteSpace(message.Text))
                {
                    <p>@message.Text</p>
                }
                @if (!string.IsNullOrWhiteSpace(message.ImageUrl))
                {
                    <a class="support-chat-attachment" href="@message.ImageUrl" target="_blank" rel="noopener">
                        <img src="@message.ImageUrl" alt="Support attachment" />
                    </a>
                }
            </article>
        }
    </div>

    <form class="support-chat-form" asp-controller="Support" asp-action="Reply" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" name="TicketId" value="@Model.Id" />
        <label class="support-file-button" aria-label="Attach image">
            <input type="file" name="ImageFile" accept=".png,.jpg,.jpeg,image/png,image/jpeg" />
            <span>+</span>
        </label>
        <input type="text" name="Text" placeholder="Type your message" maxlength="2000" />
        <button type="submit">Send</button>
    </form>
</section>

@section Scripts {
    <script src="~/main assets/js/support-chat.js"></script>
}
