@inject AppDbContext DbContext
@{
    var footerSettings = await DbContext.SiteFooterSettings.AsNoTracking().FirstOrDefaultAsync(item => item.Id == 1) ?? new SiteFooterSettings();
    var footerPhoneHref = new string(footerSettings.Phone.Where(item => char.IsDigit(item) || item == '+').ToArray());
}
<!DOCTYPE html>
<html class="no-js" lang="zxx">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="meta description" />
    <title>@ViewData["Title"] - Juan</title>
    <link rel="shortcut icon" href="~/main assets/img/favicon.ico" type="image/x-icon" />
    <link href="~/main assets/css/plugins.css" rel="stylesheet" />
    <link href="~/main assets/css/vendor.css" rel="stylesheet" />
    <link href="~/main assets/css/style.css" rel="stylesheet" />
    <link href="~/main assets/css/account.css" rel="stylesheet" />
    <link href="~/main assets/css/home-admin.css" rel="stylesheet" />
    <style>
        .shop-list-modal{position:fixed;inset:0;z-index:9999;display:none;align-items:center;justify-content:center;padding:24px;background:rgba(15,18,25,.62)}
        .shop-list-modal.is-open{display:flex}
        .shop-list-panel{width:min(760px,100%);max-height:86vh;overflow:hidden;background:#fff;border-radius:8px;box-shadow:0 24px 80px rgba(15,18,25,.28)}
        .shop-list-head{display:flex;align-items:center;justify-content:space-between;padding:22px 24px;border-bottom:1px solid #eee}
        .shop-list-head h3{margin:0;font-size:22px;color:#222}
        .shop-list-tabs{display:flex;gap:8px;padding:16px 24px 0}
        .shop-list-tab{border:1px solid #e3a51e;background:#fff;color:#222;padding:9px 16px;border-radius:6px;cursor:pointer}
        .shop-list-tab.active{background:#e3a51e;color:#fff}
        .shop-list-body{padding:18px 24px 24px;max-height:52vh;overflow:auto}
        .shop-list-row{display:grid;grid-template-columns:74px 1fr auto;gap:16px;align-items:center;padding:14px 0;border-bottom:1px solid #f1f1f1}
        .shop-list-row img{width:74px;height:74px;object-fit:cover;border-radius:8px;background:#f6f6f6}
        .shop-list-row h4{margin:0 0 6px;font-size:16px;color:#222}
        .shop-list-row p{margin:0;color:#777}
        .shop-list-remove{border:0;background:#f5ece1;color:#a86807;width:36px;height:36px;border-radius:50%;cursor:pointer;font-size:22px;line-height:1}
        .shop-list-empty{padding:34px 12px;text-align:center;color:#777}
        .shop-list-foot{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:18px 24px;background:#faf7f2;border-top:1px solid #eee}
        .shop-list-actions{display:flex;align-items:center;gap:10px;flex-wrap:wrap;justify-content:flex-end}
        .shop-list-total{font-size:18px;color:#222}
        .shop-list-checkout.is-disabled{pointer-events:none;opacity:.55}
        .shop-list-close{border:0;background:transparent;font-size:30px;line-height:1;cursor:pointer;color:#555}
        .shop-action-message{position:fixed;right:22px;bottom:22px;z-index:10000;background:#222;color:#fff;padding:12px 16px;border-radius:8px;box-shadow:0 14px 40px rgba(0,0,0,.22);opacity:0;transform:translateY(12px);transition:.2s}
        .shop-action-message.is-visible{opacity:1;transform:translateY(0)}
        .header-configure-wrapper{display:flex;justify-content:flex-end}
        .header-configure-area{padding-right:0}
        .header-configure-area>.nav{align-items:center;justify-content:flex-end!important;flex-wrap:nowrap;gap:12px}
        .header-configure-area>.nav>li{margin-left:0}
        .header-configure-area>.nav>li>a:not(.header-user-name){display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;font-size:20px;border-radius:50%;color:#222}
        .header-configure-area>.nav>li>a:not(.header-user-name):hover,.header-configure-area>.nav>li>a.is-active{color:#e3a51e;background:#fff7e7}
        .header-configure-area>.nav>li>a .notification{top:-2px;right:-2px}
        .header-user-name{display:block;max-width:88px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:18px!important;font-weight:700;letter-spacing:0;color:#222}
        .mobile-menu-toggler{gap:16px}
        .mobile-menu-toggler>a{color:#000!important}
        .mobile-menu-toggler>a i{font-size:27px;line-height:1;color:#000}
        .mobile-user-name{display:block;max-width:84px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#000;font-size:24px;font-weight:800;line-height:1}
        .mobile-shop-icons{display:flex;align-items:center;justify-content:flex-end;gap:16px}
        .mobile-shop-icons a[data-open-shop-list]{position:relative;display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;color:#000!important}
        .mobile-shop-icons a[data-open-shop-list] i{font-size:27px;line-height:1;color:#000}
        .mobile-shop-icons a[data-open-shop-list] .notification{position:absolute;top:0;right:0;width:16px;height:16px;line-height:16px;text-align:center;border-radius:50%;font-size:10px;color:#fff;background:#e3a51e}
        .product-action-link a.is-active{color:#fff;background-color:#e3a51e}
        @@media (max-width:575px){.shop-list-row{grid-template-columns:60px 1fr auto}.shop-list-row img{width:60px;height:60px}.shop-list-foot{display:block}.shop-list-total{margin-bottom:12px}.shop-list-actions{justify-content:flex-start}}
    </style>
    <script src="~/main assets/js/modernizr-2.8.3.min.js"></script>
</head>
<body data-user-authenticated="@(User.Identity?.IsAuthenticated == true ? "true" : "false")">

    <div class="page-loader" aria-hidden="true">
        <div class="page-loader-mark">
            <span></span>
            <span></span>
            <span></span>
        </div>
    </div>
    <form id="shop-list-token-form" class="d-none">@Html.AntiForgeryToken()</form>

    <div class="page-shell">
        <main>
            @RenderBody()
        </main>

        <footer class="footer-wrapper">
        <div class="footer-widget-area section-padding">
            <div class="container">
                <div class="row mtn-40">
                    <div class="col-xl-5 col-lg-3 col-md-6">
                        <div class="widget-item mt-40">
                            <h5 class="widget-title">My Account</h5>
                            <div class="widget-body">
                                <ul class="location-wrap">
                                    <li><i class="ion-ios-location-outline"></i>@footerSettings.Address</li>
                                    <li><i class="ion-ios-email-outline"></i>Mail Us: <a href="mailto:@footerSettings.Email">@footerSettings.Email</a></li>
                                    <li><i class="ion-ios-telephone-outline"></i>Phone: <a href="tel:@footerPhoneHref">@footerSettings.Phone</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-2 col-lg-3 col-md-6">
                        <div class="widget-item mt-40">
                            <h5 class="widget-title">Categories</h5>
                            <div class="widget-body">
                                <ul class="useful-link">
                                    <li><a href="@footerSettings.AllProductsUrl">All Products</a></li>
                                    <li><a href="@footerSettings.CategoriesUrl">Categories</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-2 col-lg-3 col-md-6">
                        <div class="widget-item mt-40">
                            <h5 class="widget-title">Information</h5>
                            <div class="widget-body">
                                <ul class="useful-link">
                                    <li><a href="@footerSettings.HomeUrl">Home</a></li>
                                    <li><a href="@footerSettings.AboutUrl">About Us</a></li>
                                    <li><a href="@footerSettings.ContactUrl">Contact Us</a></li>
                                    <li><a href="@footerSettings.PrivacyUrl">Privacy Policy</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-2 offset-xl-1 col-lg-3 col-md-6">
                        <div class="widget-item mt-40">
                            <h5 class="widget-title">Subscribe</h5>
                            <div class="widget-body">
                                @if (TempData["SubscribeMessage"] is string subscribeMessage)
                                {
                                    <p>@subscribeMessage</p>
                                }
                                <form asp-controller="Home" asp-action="SubscribeEmail" method="post" class="footer-subscribe-form">
                                    <input name="email" type="email" placeholder="Email address" required />
                                    <button type="submit">Subscribe</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <div class="container">
                <div class="row">
                    <div class="col-md-6 order-2 order-md-1">
                        <div class="copyright-text text-center text-md-left">
                            <p>Copyright 2026 <a asp-controller="Home" asp-action="Index">Juan</a>. All Rights Reserved</p>
                        </div>
                    </div>
                    <div class="col-md-6 order-1 order-md-2">
                        <div class="footer-social-link text-center text-md-right">
                            <a href="@footerSettings.FacebookUrl"><i class="fa fa-facebook"></i></a>
                            <a href="@footerSettings.TwitterUrl"><i class="fa fa-twitter"></i></a>
                            <a href="@footerSettings.LinkedinUrl"><i class="fa fa-linkedin"></i></a>
                            <a href="@footerSettings.InstagramUrl"><i class="fa fa-instagram"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        </footer>

        <div class="offcanvas-search-wrapper">
        <div class="offcanvas-search-inner">
            <div class="offcanvas-close"><i class="ion-android-close"></i></div>
            <div class="container">
                <div class="offcanvas-search-box">
                    <form class="d-flex bdr-bottom w-100">
                        <input type="text" placeholder="Search entire storage here..." />
                        <button class="search-btn"><i class="ion-ios-search-strong"></i>search</button>
                    </form>
                </div>
            </div>
        </div>
        </div>

        <div class="offcanvas-minicart-wrapper">
        <div class="minicart-inner">
            <div class="offcanvas-overlay"></div>
            <div class="minicart-inner-content">
                <div class="minicart-close"><i class="ion-android-close"></i></div>
                <div class="minicart-content-box">
                    <div class="minicart-item-wrapper">
                        <ul id="minicart-items"></ul>
                    </div>
                    <div class="minicart-pricing-box">
                        <ul>
                            <li><span>sub-total</span><span><strong>$0.00</strong></span></li>
                            <li class="total"><span>total</span><span><strong>$0.00</strong></span></li>
                        </ul>
                    </div>
                    <div class="minicart-button">
                        <a href="#"><i class="fa fa-shopping-cart"></i> view cart</a>
                        <a href="#"><i class="fa fa-share"></i> checkout</a>
                    </div>
                </div>
            </div>
        </div>
        </div>

        <div class="shop-list-modal" data-shop-list-modal>
            <div class="shop-list-panel" role="dialog" aria-modal="true" aria-labelledby="shop-list-title">
                <div class="shop-list-head">
                    <h3 id="shop-list-title" data-shop-list-title>Basket</h3>
                    <button type="button" class="shop-list-close" data-shop-list-close>&times;</button>
                </div>
                <div class="shop-list-tabs">
                    <button type="button" class="shop-list-tab active" data-shop-list-tab="basket">Basket</button>
                    <button type="button" class="shop-list-tab" data-shop-list-tab="wishlist">Wishlist</button>
                </div>
                <div class="shop-list-body" data-shop-list-body></div>
                <div class="shop-list-foot">
                    <div class="shop-list-total" data-shop-list-total>Total: $0.00</div>
                    <div class="shop-list-actions">
                        <a class="btn btn-hero shop-list-checkout" asp-controller="Payment" asp-action="Index" data-shop-list-checkout>Checkout</a>
                        <a class="btn btn-hero" asp-controller="Products" asp-action="Index">Continue Shopping</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="shop-action-message" data-shop-action-message></div>

        <div class="scroll-top not-visible">
            <i class="fa fa-angle-up"></i>
        </div>
    </div>

    <script src="~/main assets/js/vendor.js"></script>
    <script src="~/main assets/js/plugins.js"></script>
    <script src="~/main assets/js/active.js"></script>
    <script>
        (function () {
            var isAuthenticated = document.body.dataset.userAuthenticated === "true";
            var basketKey = "juan.basket";
            var wishlistKey = "juan.wishlist";
            var activeList = "basket";
            var modal = document.querySelector("[data-shop-list-modal]");
            var body = document.querySelector("[data-shop-list-body]");
            var title = document.querySelector("[data-shop-list-title]");
            var total = document.querySelector("[data-shop-list-total]");
            var checkoutLink = document.querySelector("[data-shop-list-checkout]");
            var message = document.querySelector("[data-shop-action-message]");
            var tokenInput = document.querySelector("#shop-list-token-form input[name='__RequestVerificationToken']");
            var summary = { basketItems: readLocal(basketKey), wishlistItems: readLocal(wishlistKey) };

            refreshState();
            bindActions();

            function bindActions() {
                document.addEventListener("click", function (event) {
                    var opener = event.target.closest("[data-open-shop-list]");
                    if (opener) {
                        event.preventDefault();
                        openList(opener.dataset.openShopList);
                        return;
                    }

                    var action = event.target.closest("[data-shop-action]");
                    if (action) {
                        event.preventDefault();
                        var card = action.closest("[data-product-card]");
                        if (card) {
                            addFromCard(action.dataset.shopAction, card, 1);
                        }
                        return;
                    }

                    var remove = event.target.closest("[data-shop-remove]");
                    if (remove) {
                        event.preventDefault();
                        removeItem(remove.dataset.shopRemove, parseInt(remove.dataset.productId, 10));
                    }
                });

                document.querySelectorAll("[data-shop-list-tab]").forEach(function (tab) {
                    tab.addEventListener("click", function () {
                        openList(tab.dataset.shopListTab);
                    });
                });

                document.querySelectorAll("[data-shop-list-close]").forEach(function (button) {
                    button.addEventListener("click", closeList);
                });

                if (modal) {
                    modal.addEventListener("click", function (event) {
                        if (event.target === modal) {
                            closeList();
                        }
                    });
                }

                document.addEventListener("submit", function (event) {
                    var form = event.target.closest("[data-modal-basket-form]");
                    if (!form) {
                        return;
                    }

                    var productId = parseInt(form.querySelector("[name='productId']").value, 10);
                    var quantity = parseInt(form.querySelector("[name='quantity']").value, 10) || 1;
                    var card = document.querySelector("[data-product-card][data-product-id='" + productId + "']");
                    if (card) {
                        event.preventDefault();
                        addFromCard("basket", card, quantity);
                        if (window.jQuery && window.jQuery.fn.modal) {
                            window.jQuery("#quick_view").modal("hide");
                        }
                    }
                });
            }

            function addFromCard(type, card, quantity) {
                var item = {
                    productId: parseInt(card.dataset.productId, 10),
                    name: card.dataset.productName || "",
                    price: parsePrice(card.dataset.productPrice),
                    imageUrl: card.dataset.productImage || "/main assets/img/product/product-1.jpg",
                    quantity: Math.max(1, quantity || 1),
                    stockCount: parseInt(card.dataset.productStock, 10) || 99
                };

                if (type === "wishlist" && hasItem(summary.wishlistItems, item.productId)) {
                    removeItem("wishlist", item.productId, "Removed from wishlist");
                    return;
                }

                if (isAuthenticated) {
                    post(type === "basket" ? "@Url.Action("AddBasket", "ShopList")" : "@Url.Action("AddWishlist", "ShopList")", { productId: item.productId, quantity: item.quantity })
                        .then(applySummary)
                        .then(function () { showMessage(type === "basket" ? "Added to basket" : "Added to wishlist"); })
                        .catch(function () { showMessage("Request failed"); });
                    return;
                }

                if (type === "basket") {
                    summary.basketItems = upsertBasket(summary.basketItems, item);
                    writeLocal(basketKey, summary.basketItems);
                    showMessage("Saved to local basket");
                } else {
                    summary.wishlistItems = upsertWishlist(summary.wishlistItems, item);
                    writeLocal(wishlistKey, summary.wishlistItems);
                    showMessage("Saved to local wishlist");
                }

                render();
            }

            function removeItem(type, productId, successMessage) {
                if (isAuthenticated) {
                    post(type === "basket" ? "@Url.Action("RemoveBasket", "ShopList")" : "@Url.Action("RemoveWishlist", "ShopList")", { productId: productId })
                        .then(applySummary)
                        .then(function () {
                            if (successMessage) {
                                showMessage(successMessage);
                            }
                        })
                        .catch(function () { showMessage("Request failed"); });
                    return;
                }

                if (type === "basket") {
                    summary.basketItems = summary.basketItems.filter(function (item) { return item.productId !== productId; });
                    writeLocal(basketKey, summary.basketItems);
                } else {
                    summary.wishlistItems = summary.wishlistItems.filter(function (item) { return item.productId !== productId; });
                    writeLocal(wishlistKey, summary.wishlistItems);
                }

                render();
                if (successMessage) {
                    showMessage(successMessage);
                }
            }

            function refreshState() {
                if (!isAuthenticated) {
                    render();
                    return;
                }

                syncLocal().then(function () {
                    return fetch("@Url.Action("Summary", "ShopList")");
                }).then(function (response) {
                    return response.json();
                }).then(applySummary);
            }

            function syncLocal() {
                var localBasket = readLocal(basketKey);
                var localWishlist = readLocal(wishlistKey);
                if (!localBasket.length && !localWishlist.length) {
                    return Promise.resolve();
                }

                return fetch("@Url.Action("Sync", "ShopList")", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "RequestVerificationToken": tokenInput ? tokenInput.value : ""
                    },
                    body: JSON.stringify({ basketItems: localBasket, wishlistItems: localWishlist })
                }).then(function (response) {
                    if (response.ok) {
                        localStorage.removeItem(basketKey);
                        localStorage.removeItem(wishlistKey);
                    }
                });
            }

            function post(url, data) {
                var form = new URLSearchParams();
                Object.keys(data).forEach(function (key) {
                    form.append(key, data[key]);
                });

                return fetch(url, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/x-www-form-urlencoded",
                        "RequestVerificationToken": tokenInput ? tokenInput.value : ""
                    },
                    body: form.toString()
                }).then(function (response) {
                    if (!response.ok) {
                        throw new Error("Request failed");
                    }

                    return response.json();
                });
            }

            function applySummary(data) {
                summary = {
                    basketItems: normalizeItems(data.basketItems),
                    wishlistItems: normalizeItems(data.wishlistItems)
                };
                render();
            }

            function openList(type) {
                activeList = type === "wishlist" ? "wishlist" : "basket";
                render();
                if (modal) {
                    modal.classList.add("is-open");
                }
            }

            function closeList() {
                if (modal) {
                    modal.classList.remove("is-open");
                }
            }

            function render() {
                var items = activeList === "basket" ? summary.basketItems : summary.wishlistItems;
                document.querySelectorAll("[data-basket-count]").forEach(function (item) { item.textContent = countBasket(); });
                document.querySelectorAll("[data-wishlist-count]").forEach(function (item) { item.textContent = summary.wishlistItems.length; });
                renderProductStates();

                if (!body) {
                    return;
                }

                document.querySelectorAll("[data-shop-list-tab]").forEach(function (tab) {
                    tab.classList.toggle("active", tab.dataset.shopListTab === activeList);
                });

                title.textContent = activeList === "basket" ? "Basket" : "Wishlist";
                total.textContent = activeList === "basket" ? "Total: " + formatMoney(sumBasket()) : summary.wishlistItems.length + " saved item(s)";
                if (checkoutLink) {
                    var canCheckout = activeList === "basket" && countBasket() > 0;
                    checkoutLink.classList.toggle("is-disabled", !canCheckout);
                    checkoutLink.setAttribute("aria-disabled", canCheckout ? "false" : "true");
                    checkoutLink.style.display = activeList === "basket" ? "inline-block" : "none";
                }

                if (!items.length) {
                    body.innerHTML = "<div class=\"shop-list-empty\">No items yet.</div>";
                    return;
                }

                body.innerHTML = items.map(function (item) {
                    var qty = activeList === "basket" ? "Qty: " + item.quantity + " · " : "";
                    return "<div class=\"shop-list-row\">" +
                        "<img src=\"" + escapeHtml(item.imageUrl) + "\" alt=\"" + escapeHtml(item.name) + "\" />" +
                        "<div><h4>" + escapeHtml(item.name) + "</h4><p>" + qty + formatMoney(item.price) + "</p></div>" +
                        "<button class=\"shop-list-remove\" type=\"button\" data-shop-remove=\"" + activeList + "\" data-product-id=\"" + item.productId + "\">&times;</button>" +
                        "</div>";
                }).join("");
            }

            function readLocal(key) {
                try {
                    return normalizeItems(JSON.parse(localStorage.getItem(key) || "[]"));
                } catch {
                    return [];
                }
            }

            function writeLocal(key, items) {
                localStorage.setItem(key, JSON.stringify(items));
            }

            function normalizeItems(items) {
                return Array.isArray(items) ? items.map(function (item) {
                    return {
                        productId: parseInt(item.productId || item.ProductId, 10),
                        name: item.name || item.Name || "",
                        imageUrl: item.imageUrl || item.ImageUrl || "/main assets/img/product/product-1.jpg",
                        price: Number(item.price || item.Price || 0),
                        quantity: Math.max(1, parseInt(item.quantity || item.Quantity || 1, 10)),
                        stockCount: parseInt(item.stockCount || item.StockCount || 99, 10)
                    };
                }).filter(function (item) { return item.productId > 0; }) : [];
            }

            function upsertBasket(items, item) {
                var existing = items.find(function (saved) { return saved.productId === item.productId; });
                if (existing) {
                    existing.quantity = Math.min(existing.stockCount || 99, existing.quantity + item.quantity);
                    return items;
                }

                return [item].concat(items);
            }

            function upsertWishlist(items, item) {
                return items.some(function (saved) { return saved.productId === item.productId; }) ? items : [item].concat(items);
            }

            function hasItem(items, productId) {
                return items.some(function (item) { return item.productId === productId; });
            }

            function renderProductStates() {
                document.querySelectorAll("[data-product-card]").forEach(function (card) {
                    var productId = parseInt(card.dataset.productId, 10);
                    var wishlistLink = card.querySelector("[data-shop-action='wishlist']");
                    var basketLink = card.querySelector("[data-shop-action='basket']");
                    var inWishlist = hasItem(summary.wishlistItems, productId);
                    var inBasket = hasItem(summary.basketItems, productId);

                    setActionState(wishlistLink, inWishlist, inWishlist ? "fa fa-heart" : "fa fa-heart-o", inWishlist ? "Remove from Wishlist" : "Wishlist");
                    setActionState(basketLink, inBasket, "fa fa-shopping-bag", inBasket ? "Add One More" : "Add To Cart");
                });

                document.querySelectorAll("[data-open-shop-list='wishlist']").forEach(function (link) {
                    link.classList.toggle("is-active", summary.wishlistItems.length > 0);
                });

                document.querySelectorAll("[data-open-shop-list='basket']").forEach(function (link) {
                    link.classList.toggle("is-active", summary.basketItems.length > 0);
                });
            }

            function setActionState(link, active, iconClass, titleText) {
                if (!link) {
                    return;
                }

                link.classList.toggle("is-active", active);
                link.setAttribute("title", titleText);
                link.setAttribute("aria-label", titleText);
                link.setAttribute("data-original-title", titleText);

                var icon = link.querySelector("i");
                if (icon) {
                    icon.className = iconClass;
                }
            }

            function countBasket() {
                return summary.basketItems.reduce(function (sum, item) { return sum + item.quantity; }, 0);
            }

            function sumBasket() {
                return summary.basketItems.reduce(function (sum, item) { return sum + item.quantity * item.price; }, 0);
            }

            function parsePrice(value) {
                return Number(String(value || "0").replace(/[^0-9.]/g, "")) || 0;
            }

            function formatMoney(value) {
                return new Intl.NumberFormat("en-US", { style: "currency", currency: "USD" }).format(value || 0);
            }

            function escapeHtml(value) {
                return String(value || "").replace(/[&<>"']/g, function (match) {
                    return { "&": "&amp;", "<": "&lt;", ">": "&gt;", "\"": "&quot;", "'": "&#039;" }[match];
                });
            }

            function showMessage(text) {
                if (!message) {
                    return;
                }

                message.textContent = text;
                message.classList.add("is-visible");
                window.setTimeout(function () {
                    message.classList.remove("is-visible");
                }, 1800);
            }
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
