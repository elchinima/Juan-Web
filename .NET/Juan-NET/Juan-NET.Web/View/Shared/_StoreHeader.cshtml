@inject AdminAccessService AdminAccessService
@{
    var canAccessAdmin = User.Identity?.IsAuthenticated == true && await AdminAccessService.HasPermissionAsync(User, AdminPermissionKeys.AdminAccess);
    var rawUserName = User.Identity?.Name ?? string.Empty;
    var displayUserName = rawUserName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? rawUserName;
    displayUserName = displayUserName.Length > 10 ? $"{displayUserName[..10]}..." : displayUserName;
}
<header class="header-area">
    <div class="main-header d-none d-lg-block">
        <div class="header-main-area sticky">
            <div class="container">
                <div class="row align-items-center position-relative">
                    <div class="col-lg-2">
                        <div class="logo">
                            <a asp-controller="Home" asp-action="Index">
                                <img src="~/main assets/img/logo/logo.png" alt="Logo" />
                            </a>
                        </div>
                    </div>
                    <div class="col-lg-8 position-static">
                        <div class="main-menu-area">
                            <div class="main-menu">
                                <nav class="desktop-menu">
                                    <ul>
                                        <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                                        <li><a asp-controller="Products" asp-action="Index">Shop</a></li>
                                        <li><a asp-controller="Categories" asp-action="Index">Categories</a></li>
                                        <li><a asp-controller="Home" asp-action="Contact">Contact us</a></li>
                                    </ul>
                                </nav>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-2">
                        <div class="header-configure-wrapper">
                            <div class="header-configure-area">
                                <ul class="nav justify-content-end">
                                    <li class="user-hover">
                                        @if (User.Identity?.IsAuthenticated == true)
                                        {
                                            <a asp-controller="Account" asp-action="Profile" class="header-user-name" title="@rawUserName">@displayUserName</a>
                                        }
                                        else
                                        {
                                            <a asp-controller="Account" asp-action="Login"><i class="ion-log-in"></i></a>
                                        }
                                        <ul class="dropdown-list">
                                            @if (User.Identity?.IsAuthenticated == true)
                                            {
                                                <li><a asp-controller="Account" asp-action="Profile">profile</a></li>
                                                <li>
                                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                                        <button type="submit">logout</button>
                                                    </form>
                                                </li>
                                            }
                                            else
                                            {
                                                <li><a asp-controller="Account" asp-action="Login">login</a></li>
                                                <li><a asp-controller="Account" asp-action="Register">register</a></li>
                                            }
                                            @if (canAccessAdmin)
                                            {
                                                <li><a asp-controller="Admin" asp-action="Index">admin</a></li>
                                            }
                                        </ul>
                                    </li>
                                    <li>
                                        <a href="#" data-open-shop-list="wishlist" data-no-transition title="Wishlist"><i class="fa fa-heart-o"></i><div class="notification" data-wishlist-count>0</div></a>
                                    </li>
                                    <li>
                                        <a href="#" data-open-shop-list="basket" data-no-transition title="Basket"><i class="fa fa-shopping-bag"></i><div class="notification" data-basket-count>0</div></a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="mobile-header d-lg-none d-md-block sticky">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-12">
                    <div class="mobile-main-header">
                        <div class="mobile-logo">
                            <a asp-controller="Home" asp-action="Index"><img src="~/main assets/img/logo/logo.png" alt="Brand Logo" /></a>
                        </div>
                        <div class="mobile-menu-toggler">
                            <a asp-controller="Account" asp-action="@(User.Identity?.IsAuthenticated == true ? "Profile" : "Login")">
                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <span class="mobile-user-name" title="@rawUserName">@displayUserName</span>
                                }
                                else
                                {
                                    <i class="ion-log-in"></i>
                                }
                            </a>
                            <a href="#" data-open-shop-list="wishlist" data-no-transition><i class="fa fa-heart-o"></i><span class="notification" data-wishlist-count>0</span></a>
                            <a href="#" data-open-shop-list="basket" data-no-transition><i class="fa fa-shopping-bag"></i><span class="notification" data-basket-count>0</span></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>
