<header class="header-area">
    <div class="main-header d-none d-lg-block">
        <div class="header-top theme-bg">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-6">
                        <div class="welcome-message">
                            <p>Welcome to Juan online store</p>
                        </div>
                    </div>
                    <div class="col-lg-6 text-right">
                        <div class="header-top-settings">
                            <ul class="nav align-items-center justify-content-end">
                                <li><a asp-controller="Admin" asp-action="Index">Admin Panel</a></li>
                                <li><a asp-controller="Account" asp-action="Register">Register</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="header-main-area sticky">
            <div class="container">
                <div class="row align-items-center position-relative">
                    <div class="col-lg-2">
                        <div class="logo">
                            <a asp-controller="Home" asp-action="Index">
                                <img src="~/main assets/img/logo/logo.png" alt="Logo" />
                            </a>
                        </div>
                    </div>
                    <div class="col-lg-8 position-static">
                        <div class="main-menu-area">
                            <div class="main-menu">
                                <nav class="desktop-menu">
                                    <ul>
                                        <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                                        <li><a asp-controller="Products" asp-action="Index">Shop</a></li>
                                        <li><a asp-controller="Categories" asp-action="Index">Categories</a></li>
                                        <li><a asp-controller="Home" asp-action="Contact">Contact us</a></li>
                                    </ul>
                                </nav>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-2">
                        <div class="header-configure-wrapper">
                            <div class="header-configure-area">
                                <ul class="nav justify-content-end">
                                    <li class="user-hover">
                                        <a asp-controller="Account" asp-action="Register"><i class="ion-ios-gear-outline"></i></a>
                                        <ul class="dropdown-list">
                                            <li><a asp-controller="Account" asp-action="Register">register</a></li>
                                            <li><a asp-controller="Admin" asp-action="Index">admin</a></li>
                                        </ul>
                                    </li>
                                    <li>
                                        <a href="#" class="minicart-btn"><i class="ion-bag"></i><div class="notification">0</div></a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="mobile-header d-lg-none d-md-block sticky">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-12">
                    <div class="mobile-main-header">
                        <div class="mobile-logo">
                            <a asp-controller="Home" asp-action="Index"><img src="~/main assets/img/logo/logo.png" alt="Brand Logo" /></a>
                        </div>
                        <div class="mobile-menu-toggler">
                            <a asp-controller="Account" asp-action="Register"><i class="ion-ios-gear-outline"></i></a>
                            <a asp-controller="Products" asp-action="Index"><i class="ion-bag"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>
