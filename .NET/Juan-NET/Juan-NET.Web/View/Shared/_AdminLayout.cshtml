<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Juan Admin</title>
    <link rel="shortcut icon" href="~/admin assets/img/logo.png" type="image/png" />
    <link rel="stylesheet" href="~/admin assets/css/admin.css" />
</head>
<body data-page="@ViewData["PageName"]">
    <div class="admin-shell">
        <aside class="sidebar">
            <a class="brand" asp-controller="Admin" asp-action="Index">
                <img src="~/admin assets/img/logo.png" alt="Juan" />
                <span>Admin</span>
            </a>
            <nav class="side-nav" aria-label="Admin navigation">
                <a class="@(ViewData["ActivePage"]?.ToString() == "Dashboard" ? "active" : "")"
                   asp-controller="Admin" asp-action="Index">Dashboard</a>
                <a class="@(ViewData["ActivePage"]?.ToString() == "Products" ? "active" : "")"
                   asp-controller="Admin" asp-action="Products">Products</a>
                <a class="@(ViewData["ActivePage"]?.ToString() == "Categories" ? "active" : "")"
                   asp-controller="Admin" asp-action="Categories">Categories</a>
                <a class="@(ViewData["ActivePage"]?.ToString() == "Sliders" ? "active" : "")"
                   asp-controller="Admin" asp-action="Sliders">Sliders</a>
                <a class="@(ViewData["ActivePage"]?.ToString() == "ContactMessages" ? "active" : "")"
                   asp-controller="Admin" asp-action="ContactMessages">Messages</a>
                <a class="@(ViewData["ActivePage"]?.ToString() == "Users" ? "active" : "")"
                   asp-controller="Admin" asp-action="Users">Users</a>
                <a class="@(ViewData["ActivePage"]?.ToString() == "Subscribe" ? "active" : "")"
                   asp-controller="Admin" asp-action="Subscribe">Subscribe</a>
            </nav>
            <div class="sidebar-card">
                @RenderSection("SidebarCard", required: false)
            </div>
        </aside>

        <main class="main-panel">
            @RenderBody()
        </main>
    </div>
    <div class="admin-modal confirm-modal" data-confirm-modal>
        <div class="admin-modal-backdrop" data-confirm-cancel></div>
        <section class="admin-modal-panel confirm-modal-panel" role="dialog" aria-modal="true" aria-labelledby="confirm-title">
            <div class="panel-head">
                <div>
                    <p class="eyebrow">Confirm</p>
                    <h3 id="confirm-title">Confirm Action</h3>
                </div>
                <button class="modal-close" type="button" aria-label="Close modal" data-confirm-cancel>&times;</button>
            </div>
            <p data-confirm-message>Are you sure you want to continue?</p>
            <div class="confirm-actions">
                <button class="ghost-button" type="button" data-confirm-cancel>Cancel</button>
                <button class="danger-button" type="button" data-confirm-accept>Confirm</button>
            </div>
        </section>
    </div>
    <script src="~/admin assets/js/admin.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
