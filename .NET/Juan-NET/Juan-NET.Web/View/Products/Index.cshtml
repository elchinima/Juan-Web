@model ProductsIndexViewModel
@{
    ViewData["Title"] = "Products";
}

@await Html.PartialAsync("_StoreHeader")

<div class="breadcrumb-area bg-img" data-bg="/main assets/img/banner/breadcrumb-banner.jpg">
    <div class="container">
        <div class="breadcrumb-wrap text-center">
            <h2 class="breadcrumb-title">Products</h2>
            <nav aria-label="breadcrumb">
                <ul class="breadcrumb justify-content-center">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Products</li>
                </ul>
            </nav>
        </div>
    </div>
</div>

<section class="our-product section-padding">
    <div class="container">
        @if (Model.Products.Any())
        {
            <div class="row mbn-50 product-page-grid">
                @foreach (var product in Model.Products)
                {
                    var imageUrl = string.IsNullOrWhiteSpace(product.ImageUrl) ? Url.Content("~/main assets/img/product/product-1.jpg") : product.ImageUrl;
                    var categories = string.Join(", ", product.ProductCategories.Select(productCategory => productCategory.Category.Name));
                    var description = string.IsNullOrWhiteSpace(product.Description) ? "No description available." : product.Description;
                    var isOutOfStock = product.StockCount < 1;
                    <div class="col-lg-3 col-md-4 col-sm-6">
                        <div class="product-item mb-50 @(isOutOfStock ? "is-out-of-stock" : "")"
                             data-product-card
                             data-product-id="@product.Id"
                             data-product-name="@product.Name"
                             data-product-price="@product.Price.ToString("C")"
                             data-product-image="@imageUrl"
                             data-product-description="@description"
                             data-product-categories="@categories"
                             data-product-stock="@product.StockCount"
                             data-product-out-of-stock="@isOutOfStock.ToString().ToLowerInvariant()">
                            <div class="product-thumb">
                                <a href="#" data-product-quick-view>
                                    <img src="@imageUrl" alt="@product.Name" />
                                </a>
                                @if (isOutOfStock)
                                {
                                    <span class="product-stock-badge">Out of stock</span>
                                }
                            </div>
                            <div class="product-content">
                                <h5 class="product-name"><a href="#" data-product-quick-view>@product.Name</a></h5>
                                <div class="price-box">
                                    <span class="price-regular">@product.Price.ToString("C")</span>
                                </div>
                                <p>@categories</p>
                                @if (!isOutOfStock)
                                {
                                    <div class="product-action-link">
                                        <a href="#" data-shop-action="wishlist" data-no-transition data-toggle="tooltip" title="Wishlist"><i class="fa fa-heart-o"></i></a>
                                        <a href="#" data-shop-action="basket" data-no-transition data-toggle="tooltip" title="Add To Cart"><i class="fa fa-shopping-bag"></i></a>
                                        <a href="#" data-product-quick-view data-no-transition data-toggle="tooltip" title="Quick View"><i class="fa fa-eye"></i></a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
            @if (Model.HasPreviousPage || Model.HasNextPage)
            {
                <nav class="product-pagination" aria-label="Products pagination">
                    @if (Model.HasPreviousPage)
                    {
                        <a class="btn btn-hero" asp-controller="Products" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)">Назад</a>
                    }
                    @if (Model.HasNextPage)
                    {
                        <a class="btn btn-hero" asp-controller="Products" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)">Далее</a>
                    }
                </nav>
            }
        }
        else
        {
            <div class="section-title text-center">
                <h2 class="title">No products yet</h2>
                <p class="sub-title">Add products from the admin panel and they will appear here.</p>
                <a class="btn btn-hero" asp-controller="Admin" asp-action="Products">Add Product</a>
            </div>
        }
    </div>
</section>

<div class="modal" id="quick_view">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="product-details-inner">
                    <div class="row">
                        <div class="col-lg-5">
                            <div class="product-large-slider mb-20">
                                <div class="pro-large-img img-zoom">
                                    <img src="~/main assets/img/product/product-details-img1.jpg" alt="product" data-modal-product-image />
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-7">
                            <div class="product-details-des">
                                <h3 class="pro-det-title" data-modal-product-name>Primitive Mens Premium Shoes</h3>
                                <div class="price-box">
                                    <span class="regular-price" data-modal-product-price>$70.00</span>
                                </div>
                                <p data-modal-product-description>Lorem ipsum dolor sit amet, consetetur sadipscing elitr.</p>
                                <p><strong>Category:</strong> <span data-modal-product-categories>-</span></p>
                                <p><strong>Stock:</strong> <span data-modal-product-stock>-</span></p>
                                <form asp-controller="Home" asp-action="AddToCart" method="post" class="quantity-cart-box d-flex align-items-center mb-20" data-modal-basket-form data-no-transition>
                                    <input type="hidden" name="productId" value="" data-modal-product-id />
                                    <div class="quantity">
                                        <div class="pro-qty">
                                            <input type="text" name="quantity" value="1" inputmode="numeric" pattern="[0-9]*" autocomplete="off" title="Only whole numbers from 1 to 99 are allowed" data-quantity-limit />
                                        </div>
                                    </div>
                                    <button class="btn btn-default" type="submit">Add To Cart</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .product-page-grid .product-item{height:504px}
    .product-page-grid .product-thumb{height:264px}
    .product-page-grid .product-thumb img{max-height:100%;width:auto}
    .product-pagination{display:flex;justify-content:center;gap:14px;margin-top:24px}
    .product-item.is-out-of-stock{opacity:.62;filter:grayscale(1);cursor:not-allowed}
    .product-item.is-out-of-stock .product-thumb{position:relative}
    .product-stock-badge{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);background:#222;color:#fff;border-radius:4px;padding:8px 12px;font-size:13px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;white-space:nowrap}
</style>

@section Scripts {
    <script>
        (function () {
            var modal = document.getElementById("quick_view");
            var cards = document.querySelectorAll("[data-product-card]");

            cards.forEach(function (card) {
                card.addEventListener("click", function (event) {
                    if (card.dataset.productOutOfStock === "true") {
                        event.preventDefault();
                        return;
                    }

                    var ignoredAction = event.target.closest(".product-action-link a:not([data-product-quick-view])");

                    if (ignoredAction) {
                        return;
                    }

                    event.preventDefault();
                    fillProductModal(card);

                    if (window.jQuery && window.jQuery.fn.modal) {
                        window.jQuery(modal).modal("show");
                    }
                });
            });

            function fillProductModal(card) {
                setText("[data-modal-product-name]", card.dataset.productName);
                setText("[data-modal-product-price]", card.dataset.productPrice);
                setText("[data-modal-product-description]", card.dataset.productDescription);
                setText("[data-modal-product-categories]", card.dataset.productCategories || "-");
                setText("[data-modal-product-stock]", card.dataset.productStock ? card.dataset.productStock + " item(s)" : "-");

                var productId = modal.querySelector("[data-modal-product-id]");
                if (productId) {
                    productId.value = card.dataset.productId || "";
                }

                var quantityInput = modal.querySelector("[data-quantity-limit]");
                if (quantityInput) {
                    quantityInput.value = "1";
                    quantityInput.dataset.maxQuantity = String(Math.min(parseInt(card.dataset.productStock, 10) || 1, 99));
                }

                var image = modal.querySelector("[data-modal-product-image]");
                if (image) {
                    image.src = card.dataset.productImage;
                    image.alt = card.dataset.productName;
                }
            }

            function setText(selector, value) {
                var element = modal.querySelector(selector);
                if (element) {
                    element.textContent = value || "";
                }
            }

            modal.addEventListener("input", function (event) {
                if (!event.target.matches("[data-quantity-limit]")) {
                    return;
                }

                event.target.value = event.target.value.replace(/\D/g, "");
                var maxQuantity = parseInt(event.target.dataset.maxQuantity, 10) || 99;
                var value = parseInt(event.target.value, 10);

                if (value > maxQuantity) {
                    event.target.value = String(maxQuantity);
                }
            });

            modal.addEventListener("change", function (event) {
                if (!event.target.matches("[data-quantity-limit]")) {
                    return;
                }

                normalizeQuantity(event.target);
            });

            modal.addEventListener("submit", function (event) {
                var input = event.target.querySelector("[data-quantity-limit]");
                if (!input) {
                    return;
                }

                normalizeQuantity(input);
            });

            function normalizeQuantity(input) {
                var maxQuantity = parseInt(input.dataset.maxQuantity, 10) || 99;
                var value = parseInt(input.value, 10);
                if (!value || value < 1) {
                    input.value = "1";
                    return;
                }

                if (value > maxQuantity) {
                    input.value = String(maxQuantity);
                }
            }
        })();
    </script>
}
