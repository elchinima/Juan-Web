    .product-review-pill{width:max-content;max-width:100%;background:#fff9ec;border:1px solid #f1dfba;border-radius:999px;padding:7px 12px;margin:0 0 16px}
    .product-modal-cart{display:flex;align-items:center;gap:14px;margin:0 0 18px}
    .product-modal-cart .quantity{margin:0}
    .product-modal-cart .pro-qty{border:1px solid #e0e0e0;border-radius:6px;background:#fff;height:46px}
