@model ProductsIndexViewModel
@{
    ViewData["Title"] = "Products";
}

@await Html.PartialAsync("_StoreHeader")

<div class="breadcrumb-area bg-img" data-bg="/main assets/img/banner/breadcrumb-banner.jpg">
    <div class="container">
        <div class="breadcrumb-wrap text-center">
            <h2 class="breadcrumb-title">Products</h2>
            <nav aria-label="breadcrumb">
                <ul class="breadcrumb justify-content-center">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Products</li>
                </ul>
            </nav>
        </div>
    </div>
</div>

<section class="our-product section-padding">
    <div class="container">
        <form asp-controller="Products" asp-action="Index" method="get" class="product-filter-form">
            <div class="product-search-bar">
                <input type="search" name="query" value="@Model.SearchTerm" placeholder="Search products by name" autocomplete="off" />
                <button class="btn btn-hero" type="submit">Search</button>
                <button class="btn btn-hero product-filter-button" type="button" data-toggle="modal" data-target="#product_filter">Filters</button>
                @if (!string.IsNullOrWhiteSpace(Model.SearchTerm) || Model.CategoryId.HasValue || Model.MinPrice.HasValue || Model.MaxPrice.HasValue || Model.MinRating.HasValue)
                {
                    <a class="btn btn-hero product-clear-button" asp-controller="Products" asp-action="Index">Clear</a>
                }
            </div>

            <div class="modal" id="product_filter">
                <div class="modal-dialog modal-dialog-centered product-filter-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Product filters</h5>
                            <button type="button" class="close" data-dismiss="modal">&times;</button>
                        </div>
                        <div class="modal-body">
                            <div class="product-filter-grid">
                                <label>
                                    <span>Category</span>
                                    <select name="categoryId">
                                        <option value="">All categories</option>
                                        @foreach (var category in Model.Categories)
                                        {
                                            if (Model.CategoryId == category.Id)
                                            {
                                                <option value="@category.Id" selected>@category.Name</option>
                                            }
                                            else
                                            {
                                                <option value="@category.Id">@category.Name</option>
                                            }
                                        }
                                    </select>
                                </label>
                                <label>
                                    <span>Rating</span>
                                    <select name="minRating">
                                        <option value="">Any rating</option>
                                        @foreach (var rating in new[] { 5m, 4m, 3m, 2m, 1m })
                                        {
                                            if (Model.MinRating == rating)
                                            {
                                                <option value="@rating.ToString("0")" selected>@rating.ToString("0")+ stars</option>
                                            }
                                            else
                                            {
                                                <option value="@rating.ToString("0")">@rating.ToString("0")+ stars</option>
                                            }
                                        }
                                    </select>
                                </label>
                                <label>
                                    <span>Min price</span>
                                    <input type="number" name="minPrice" value="@Model.MinPrice?.ToString("0.##", CultureInfo.InvariantCulture)" min="0" step="0.01" />
                                </label>
                                <label>
                                    <span>Max price</span>
                                    <input type="number" name="maxPrice" value="@Model.MaxPrice?.ToString("0.##", CultureInfo.InvariantCulture)" min="0" step="0.01" />
                                </label>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button class="btn btn-hero" type="submit">Apply filters</button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
        @if (Model.Products.Any())
        {
            <div class="row mbn-50 product-page-grid">
                @foreach (var product in Model.Products)
                {
                    var imageUrl = string.IsNullOrWhiteSpace(product.ImageUrl) ? Url.Content("~/main assets/img/product/product-1.jpg") : product.ImageUrl;
                    var categories = string.Join(", ", product.ProductCategories.Select(productCategory => productCategory.Category.Name));
                    var description = string.IsNullOrWhiteSpace(product.Description) ? "No description available." : product.Description;
                    var isOutOfStock = product.StockCount < 1;
                    Model.ReviewSummariesByProductId.TryGetValue(product.Id, out var reviewSummary);
                    var averageRating = reviewSummary?.AverageRating ?? 0m;
                    var reviewCount = reviewSummary?.Count ?? 0;
                    <div class="col-lg-3 col-md-4 col-sm-6">
                        <div class="product-item mb-50 @(isOutOfStock ? "is-out-of-stock" : "")"
                             data-product-card
                             data-product-id="@product.Id"
                             data-product-name="@product.Name"
                             data-product-price="@product.Price.ToString("C")"
                             data-product-image="@imageUrl"
                             data-product-description="@description"
                             data-product-categories="@categories"
                             data-product-stock="@product.StockCount"
                             data-product-rating="@averageRating.ToString("0.0")"
                             data-product-review-count="@reviewCount"
                             data-product-out-of-stock="@isOutOfStock.ToString().ToLowerInvariant()">
                            <div class="product-thumb">
                                <a href="#" data-product-quick-view>
                                    <img src="@imageUrl" alt="@product.Name" />
                                </a>
                                @if (isOutOfStock)
                                {
                                    <span class="product-stock-badge">Out of stock</span>
                                }
                            </div>
                            <div class="product-content">
                                <h5 class="product-name"><a href="#" data-product-quick-view>@product.Name</a></h5>
                                <div class="price-box">
                                    <span class="price-regular">@product.Price.ToString("C")</span>
                                </div>
                                <div class="product-review-summary">
                                    <span class="product-review-stars-small">@RenderStars(averageRating)</span>
                                    <span>@(reviewCount == 0 ? "No reviews" : $"{averageRating:0.0} ({reviewCount})")</span>
                                </div>
                                <p>@categories</p>
                                @if (!isOutOfStock)
                                {
                                    <div class="product-action-link">
                                        <a href="#" data-shop-action="wishlist" data-no-transition data-toggle="tooltip" title="Wishlist"><i class="fa fa-heart-o"></i></a>
                                        <a href="#" data-shop-action="basket" data-no-transition data-toggle="tooltip" title="Add To Cart"><i class="fa fa-shopping-bag"></i></a>
                                        <a href="#" data-product-quick-view data-no-transition data-toggle="tooltip" title="Quick View"><i class="fa fa-eye"></i></a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="product-reviews-template" data-product-reviews-template="@product.Id">
                        @{
                            var productReviews = Model.ReviewsByProductId.TryGetValue(product.Id, out var foundReviews)
                                ? foundReviews
                                : new List<ProductReviewViewModel>();
                        }
                        @if (productReviews.Any())
                        {
                            @foreach (var review in productReviews)
                            {
                                var reviewerImage = string.IsNullOrWhiteSpace(review.UserImageUrl) ? Url.Content("~/main assets/img/testimonial/testimonial-1.png") : review.UserImageUrl;
                                <div class="product-review-item">
                                    <img src="@reviewerImage" alt="@review.UserName" />
                                    <div>
                                        <div class="product-review-heading">
                                            <strong>@review.UserName</strong>
                                            <span class="product-review-badge @(review.IsVerifiedPurchase ? "verified" : "")">@(review.IsVerifiedPurchase ? "Bought and reviewed" : "Review only")</span>
                                            @if (review.CanDelete)
                                            {
                                                <form asp-controller="Products" asp-action="DeleteReview" method="post" class="product-review-delete-form" data-no-transition>
                                                    <input type="hidden" name="id" value="@review.Id" />
                                                    <button type="submit" title="Delete review" aria-label="Delete review">×</button>
                                                </form>
                                            }
                                        </div>
                                        <div class="product-review-stars-small">@RenderStars(review.Rating) <span>@review.Rating.ToString("0.0")</span></div>
                                        @if (!string.IsNullOrWhiteSpace(review.Comment))
                                        {
                                            <p>@review.Comment</p>
                                        }
                                        <small>@review.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</small>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="product-review-empty">No reviews yet.</p>
                        }
                    </div>
                }
            </div>
            @if (Model.HasPreviousPage || Model.HasNextPage)
            {
                <nav class="product-pagination" aria-label="Products pagination">
                    @if (Model.HasPreviousPage)
                    {
                        <a class="btn btn-hero" asp-controller="Products" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-query="@Model.SearchTerm" asp-route-categoryId="@Model.CategoryId" asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice" asp-route-minRating="@Model.MinRating">Назад</a>
                    }
                    @if (Model.HasNextPage)
                    {
                        <a class="btn btn-hero" asp-controller="Products" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-query="@Model.SearchTerm" asp-route-categoryId="@Model.CategoryId" asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice" asp-route-minRating="@Model.MinRating">Далее</a>
                    }
                </nav>
            }
        }
        else
        {
            <div class="section-title text-center">
                <h2 class="title">No products found</h2>
                <p class="sub-title">Try changing the search text or filters.</p>
                <a class="btn btn-hero" asp-controller="Products" asp-action="Index">Show all products</a>
            </div>
        }
    </div>
</section>

<div class="modal" id="quick_view">
    <div class="modal-dialog modal-lg modal-dialog-centered product-modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="product-details-inner">
                    <div class="row">
                        <div class="col-lg-5">
                            <div class="product-large-slider mb-20">
                                <div class="pro-large-img img-zoom">
                                    <img src="~/main assets/img/product/product-details-img1.jpg" alt="product" data-modal-product-image />
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-7">
                            <div class="product-details-des">
                                <h3 class="pro-det-title" data-modal-product-name>Primitive Mens Premium Shoes</h3>
                                <div class="price-box">
                                    <span class="regular-price" data-modal-product-price>$70.00</span>
                                </div>
                                <p data-modal-product-description>Lorem ipsum dolor sit amet, consetetur sadipscing elitr.</p>
                                <div class="product-modal-meta">
                                    <span><strong>Category</strong> <span data-modal-product-categories>-</span></span>
                                    <span><strong>Stock</strong> <span data-modal-product-stock>-</span></span>
                                </div>
                                <div class="modal-review-summary product-review-pill">
                                    <span class="product-review-stars-small" data-modal-product-stars>☆☆☆☆☆</span>
                                    <span data-modal-product-reviews>No reviews</span>
                                </div>
                                <form asp-controller="Home" asp-action="AddToCart" method="post" class="quantity-cart-box product-modal-cart" data-modal-basket-form data-no-transition>
                                    <input type="hidden" name="productId" value="" data-modal-product-id />
                                    <div class="quantity">
                                        <div class="pro-qty">
                                            <input type="text" name="quantity" value="1" inputmode="numeric" pattern="[0-9]*" autocomplete="off" title="Only whole numbers from 1 to 99 are allowed" data-quantity-limit />
                                        </div>
                                    </div>
                                    <button class="btn btn-default" type="submit">Add To Cart</button>
                                </form>
                                <div class="product-review-panel">
                                    @if (User.Identity?.IsAuthenticated == true)
                                    {
                                        <form asp-controller="Products" asp-action="Review" method="post" data-no-transition>
                                            <input type="hidden" name="ProductId" value="" data-review-product-id />
                                            <div class="product-review-panel-title">
                                                <span>Rate this product</span>
                                                <small>Share your experience</small>
                                            </div>
                                            <div class="product-review-stars-input" aria-label="Product rating">
                                                @for (var star = 5; star >= 1; star--)
                                                {
                                                    <input type="radio" id="product-review-@star" name="Rating" value="@star" @(star == 5 ? "checked" : "") />
                                                    <label for="product-review-@star">★</label>
                                                }
                                            </div>
                                            <textarea name="Comment" rows="3" maxlength="1000" placeholder="Leave a comment if you want"></textarea>
                                            <button class="btn btn-default" type="submit">Leave review</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <a class="btn btn-default" asp-controller="Account" asp-action="Login">Login to leave review</a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .product-filter-form{margin-bottom:34px}
    .product-search-bar{display:flex;gap:12px;align-items:center;justify-content:center;flex-wrap:wrap}
    .product-search-bar input{height:46px;min-width:280px;max-width:460px;width:100%;border:1px solid #e0e0e0;border-radius:4px;padding:0 14px;color:#444}
    .product-filter-button,.product-clear-button{background:#333}
    .product-filter-dialog{max-width:620px}
    #product_filter .modal-content{border:0;border-radius:8px;box-shadow:0 18px 42px rgba(0,0,0,.18)}
    #product_filter .modal-header{align-items:center;border-bottom:1px solid #eee;padding:18px 22px}
    #product_filter .modal-title{margin:0;color:#222;font-weight:800}
    #product_filter .close{font-size:28px;font-weight:300;line-height:1;opacity:.75}
    #product_filter .modal-body{padding:22px}
    #product_filter .modal-footer{border-top:1px solid #eee;padding:16px 22px}
    .product-filter-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
    .product-filter-grid label{display:block;margin:0}
    .product-filter-grid span{display:block;color:#222;font-weight:700;margin-bottom:8px}
    .product-filter-grid input,.product-filter-grid select{width:100%;height:44px;border:1px solid #e0e0e0;border-radius:4px;padding:0 12px;color:#444;background:#fff}
    .product-page-grid .product-item{height:504px}
    .product-page-grid .product-thumb{height:264px}
    .product-page-grid .product-thumb img{max-height:100%;width:auto}
    .product-pagination{display:flex;justify-content:center;gap:14px;margin-top:24px}
    .product-item.is-out-of-stock{opacity:.62;filter:grayscale(1);cursor:not-allowed}
    .product-item.is-out-of-stock .product-thumb{position:relative}
    .product-stock-badge{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);background:#222;color:#fff;border-radius:4px;padding:8px 12px;font-size:13px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;white-space:nowrap}
    .product-review-summary,.modal-review-summary{display:flex;align-items:center;gap:8px;color:#666;font-size:13px;margin:8px 0}
