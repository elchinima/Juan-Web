    .product-review-panel-title span{display:block;color:#222;font-weight:800;font-size:16px}
    .product-review-panel-title small{display:block;color:#8a8a8a;font-size:12px;margin-top:2px}
    .product-review-stars-input{display:flex;flex-direction:row-reverse;justify-content:flex-end;gap:5px;margin-bottom:12px}
    .product-review-stars-input label{font-size:30px;text-shadow:0 1px 0 rgba(0,0,0,.05)}
    .product-review-panel textarea{background:#fff;border-color:#e0e0e0;border-radius:7px;min-height:92px;margin:0 0 14px;font-size:14px}
    .product-review-list{background:#fff;border:1px solid #eeeeee;border-radius:8px;margin-top:18px;padding:4px 16px;max-height:260px}
