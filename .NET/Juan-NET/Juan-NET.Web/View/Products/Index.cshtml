    .product-review-panel{border-top:1px solid #eee;margin-top:16px;padding-top:16px}
    .product-review-panel textarea{width:100%;border:1px solid #ddd;border-radius:4px;padding:10px;margin:10px 0 12px;resize:vertical}
    .product-review-stars-input{display:inline-flex;flex-direction:row-reverse;gap:3px}
    .product-review-stars-input input{position:absolute;opacity:0;pointer-events:none}
    .product-review-stars-input label{font-size:26px;color:#d6d6d6;cursor:pointer;line-height:1}
    .product-review-stars-input input:checked ~ label,.product-review-stars-input label:hover,.product-review-stars-input label:hover ~ label{color:#e3a51e}
    .product-reviews-template{display:none}
    .product-review-list{margin-top:18px;max-height:300px;overflow:auto;border-top:1px solid #eee;padding-top:14px}
    .product-review-item{display:flex;gap:12px;padding:12px 0;border-bottom:1px solid #f1f1f1}
    .product-review-item img{width:42px;height:42px;border-radius:50%;object-fit:cover}
    .product-review-item p{margin:6px 0;color:#555}
    .product-review-heading{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
    .product-review-badge{background:#f1f1f1;color:#666;border-radius:4px;padding:3px 7px;font-size:11px;text-transform:uppercase;letter-spacing:.03em}
    .product-review-badge.verified{background:#eaf7ef;color:#1f7a3f}
    .product-review-delete-form{margin-left:auto}
    .product-review-delete-form button{width:26px;height:26px;border:0;border-radius:50%;background:#f6eaea;color:#a13a3a;font-size:20px;line-height:24px;cursor:pointer}
    .product-review-delete-form button:hover{background:#d94a4a;color:#fff}
    .product-review-empty{margin:0;color:#777}
    #quick_view .product-modal-dialog{max-width:940px}
    #quick_view .modal-content{border:0;border-radius:10px;box-shadow:0 22px 55px rgba(20,20,20,.22);overflow:hidden}
    #quick_view .modal-header{position:absolute;right:18px;top:14px;z-index:3;border:0;padding:0}
    #quick_view .modal-header .close{width:38px;height:38px;border-radius:50%;background:#fff;box-shadow:0 8px 22px rgba(0,0,0,.12);font-size:28px;font-weight:300;line-height:38px;opacity:1}
    #quick_view .modal-body{padding:28px}
    #quick_view .product-details-inner>.row{align-items:flex-start}
    #quick_view .product-large-slider{position:sticky;top:20px;margin:0;background:#f8f8f8;border:1px solid #eeeeee;border-radius:8px;overflow:hidden}
    #quick_view .pro-large-img{height:430px;display:flex;align-items:center;justify-content:center;padding:28px;background:linear-gradient(180deg,#fff 0%,#f7f7f7 100%)}
    #quick_view .pro-large-img img{max-width:100%;max-height:100%;object-fit:contain}
    #quick_view .product-details-des{padding:4px 0 0 14px}
    #quick_view .pro-det-title{font-size:28px;line-height:1.18;margin:0 44px 12px 0;color:#252525}
    #quick_view .regular-price{display:inline-block;color:#b98521;font-size:22px;font-weight:800;margin-bottom:12px}
    #quick_view [data-modal-product-description]{font-size:16px;line-height:1.7;color:#4c4c4c;margin-bottom:18px}
    .product-modal-meta{display:flex;flex-wrap:wrap;gap:10px;margin:0 0 12px}
