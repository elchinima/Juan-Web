@model SupportChatViewModel
@{
    Layout = null;
    ViewData["Title"] = "Technical Support";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Juan</title>
    <link rel="shortcut icon" href="~/admin assets/img/logo.png" type="image/png" />
    <link href="~/main assets/css/vendor.css" rel="stylesheet" />
    <link href="~/main assets/css/style.css" rel="stylesheet" />
    <link href="~/main assets/css/home-admin.css" rel="stylesheet" />
</head>
<body class="support-chat-body">
    <section class="support-chat-page">
        <nav class="support-chat-nav" aria-label="Technical support chat navigation">
            <a asp-controller="Home" asp-action="Index" aria-label="Home"><i class="fa fa-home" aria-hidden="true"></i><span>Home</span></a>
            <a class="active" asp-controller="Home" asp-action="SupportChat" aria-label="Communication"><i class="fa fa-comments-o" aria-hidden="true"></i><span>Communication</span></a>
            <a asp-controller="Home" asp-action="SupportChatHistory" aria-label="History"><i class="fa fa-history" aria-hidden="true"></i><span>History</span></a>
            <a asp-controller="Home" asp-action="SupportChatOrders" aria-label="My Orders"><i class="fa fa-shopping-bag" aria-hidden="true"></i><span>My Orders</span></a>
        </nav>

        <section class="support-chat-panel">
            <div class="support-chat-head" data-support-chat-head>
                <div>
                    @if (!Model.TicketId.HasValue)
                    {
                        <p class="contact-label" data-support-operator-role>@Model.OperatorRole</p>
                        <h1 data-support-operator-name>Create Report</h1>
                    }
                    else if (Model.IsWaitingForOperator)
                    {
                        <h1 data-support-operator-name>@Model.OperatorRole</h1>
                        <p class="contact-label" data-support-operator-role hidden>@Model.OperatorRole</p>
                    }
                    else
                    {
                        <p class="contact-label" data-support-operator-role>@Model.OperatorRole</p>
                        <h1 data-support-operator-name>@Model.OperatorFullName</h1>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Subject))
                    {
                        <p class="support-ticket-meta">@Model.Topic · @Model.Subject</p>
                    }
                </div>
                @if (!Model.TicketId.HasValue)
                {
                    <span data-support-chat-state>New</span>
                }
                else if (Model.IsWaitingForOperator)
                {
                    <span class="support-waiting-label" data-support-chat-state>Waiting<i aria-hidden="true"></i></span>
                }
                else
                {
                    <span data-support-chat-state>Online</span>
                }
            </div>

            <div class="support-chat-messages" data-support-messages data-support-chat-poll="@Url.Action("SupportChatMessages", "Home")" data-support-current-ticket-id="@Model.TicketId" data-support-inactive-url="@Url.Action("SupportChatHistory", "Home")">
                @if (Model.Messages.Any())
                {
                    @foreach (var message in Model.Messages)
                    {
                        <article class="support-chat-message @(message.IsOperator ? "agent" : "user")">
                            <strong>@message.SenderName</strong>
                            @if (!string.IsNullOrWhiteSpace(message.Text))
                            {
                                <p>@message.Text</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(message.ImageUrl))
                            {
                                <a class="support-chat-attachment" href="@message.ImageUrl" target="_blank" rel="noopener">
                                    <img src="@message.ImageUrl" alt="Support attachment" />
                                </a>
                            }
                        </article>
                    }
                }
                else if (Model.TicketId.HasValue)
                {
                    <article class="support-chat-message agent">
                        <strong>@Model.OperatorFullName</strong>
                        <p>Your request is in the queue. An operator will join this chat.</p>
                    </article>
                }
            </div>

            <form class="support-chat-form" asp-controller="Home" asp-action="SendSupportMessage" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="TicketId" value="@Model.TicketId" />
                @if (!Model.TicketId.HasValue)
                {
                    <div class="support-ticket-fields">
                        <select name="Topic" required aria-label="Report topic">
                            <option value="Technical">Technical</option>
                            <option value="Payment">Payment</option>
                            <option value="Delivery">Delivery</option>
                            <option value="Other">Other</option>
                        </select>
                        <input type="text" name="IssueTitle" placeholder="Short problem title" maxlength="160" required />
                    </div>
                }
                <label class="support-file-button" aria-label="Attach image">
                    <input type="file" name="ImageFile" accept=".png,.jpg,.jpeg,image/png,image/jpeg" />
                    <span>+</span>
                </label>
                <input type="text" name="Text" placeholder="Type your message" maxlength="2000" />
                <button type="submit">Send</button>
                <div class="support-selected-attachment" data-support-selected-attachment hidden>
                    <img alt="Selected attachment preview" data-support-selected-image />
                    <span data-support-selected-name></span>
                    <button type="button" data-support-remove-attachment aria-label="Remove attached file">Remove</button>
                </div>
            </form>
        </section>
    </section>
    <script src="~/main assets/js/support-chat.js"></script>
</body>
</html>
