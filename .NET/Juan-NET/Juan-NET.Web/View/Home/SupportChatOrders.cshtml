@model IReadOnlyList<ProfileOrderViewModel>
@{
    Layout = null;
    ViewData["Title"] = "My Orders";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Juan</title>
    <link rel="shortcut icon" href="~/admin assets/img/logo.png" type="image/png" />
    <link href="~/main assets/css/vendor.css" rel="stylesheet" />
    <link href="~/main assets/css/style.css" rel="stylesheet" />
    <link href="~/main assets/css/home-admin.css" rel="stylesheet" />
</head>
<body class="support-chat-body">
    <section class="support-chat-page support-orders-page">
        <nav class="support-chat-nav" aria-label="Technical support chat navigation">
            <a asp-controller="Home" asp-action="Index" aria-label="Home"><i class="fa fa-home" aria-hidden="true"></i><span>Home</span></a>
            <a asp-controller="Home" asp-action="SupportChat" aria-label="Communication"><i class="fa fa-comments-o" aria-hidden="true"></i><span>Communication</span></a>
            <a asp-controller="Home" asp-action="SupportChatHistory" aria-label="History"><i class="fa fa-history" aria-hidden="true"></i><span>History</span></a>
            <a class="active" asp-controller="Home" asp-action="SupportChatOrders" aria-label="My Orders"><i class="fa fa-shopping-bag" aria-hidden="true"></i><span>My Orders</span></a>
        </nav>

        <section class="support-orders-panel">
            <p class="contact-label">Orders</p>
            <h1>My Orders</h1>
            @if (TempData["RefundRequestMessage"] is string refundMessage)
            {
                <div class="support-refund-message">@refundMessage</div>
            }
            @if (!Model.Any())
            {
                <div class="support-orders-empty">
                    <p>Your orders will appear here after checkout.</p>
                    <a asp-controller="Products" asp-action="Index">Start shopping</a>
                </div>
            }
            else
            {
                <div class="support-orders-list">
                    @foreach (var order in Model)
                    {
                        <article class="support-order-card">
                            <div class="support-order-head">
                                <div>
                                    <strong>Order #@order.Id</strong>
                                    <span>@order.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</span>
                                </div>
                                <em>@order.Status</em>
                            </div>
                            <div class="support-order-items">
                                @foreach (var item in order.Items)
                                {
                                    <div class="support-order-item">
                                        <img src="@item.ImageUrl" alt="@item.ProductName" />
                                        <div>
                                            <h2>@item.ProductName</h2>
                                            <p>Qty: @item.Quantity</p>
                                            <p>Delivery: @item.UnitDeliveryPrice.ToString("C") each</p>
                                        </div>
                                        <strong>@item.LineTotal.ToString("C")</strong>
                                    </div>
                                }
                            </div>
                            <div class="support-order-total">
                                <span>Subtotal: @order.Subtotal.ToString("C")</span>
                                <span>Delivery: @order.DeliveryTotal.ToString("C")</span>
                                @if (order.DiscountTotal > 0)
                                {
                                    <span>Discount: -@order.DiscountTotal.ToString("C")</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(order.PromoCode))
                                {
                                    <span>Promo: @order.PromoCode</span>
                                }
                                <strong>Total: @order.Total.ToString("C") @order.Currency.ToUpperInvariant()</strong>
                            </div>
                            <div class="support-order-refund">
                                @if (order.CanRequestRefund)
                                {
                                    <form asp-controller="Account" asp-action="RequestRefund" method="post">
                                        <input type="hidden" name="id" value="@order.Id" />
                                        <input type="hidden" name="returnAction" value="SupportChatOrders" />
                                        <button type="submit">Refund</button>
                                    </form>
                                }
                                else if (order.Status == "Refund Requested")
                                {
                                    <span>Refund is in progress.</span>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    </section>
    <style>
        .support-refund-message{display:inline-block;margin:0 0 18px;padding:10px 14px;border-radius:6px;background:#fff7e7;color:#9a6909;font-weight:700}
        .support-order-refund{display:flex;justify-content:flex-end;margin-top:14px}
        .support-order-refund span{display:inline-block;padding:10px 14px;border-radius:6px;background:#fff7e7;color:#9a6909;font-weight:700}
        .support-order-refund button{border:0;border-radius:6px;background:#e3a51e;color:#fff;padding:10px 18px;font-weight:700;cursor:pointer}
    </style>
</body>
</html>
