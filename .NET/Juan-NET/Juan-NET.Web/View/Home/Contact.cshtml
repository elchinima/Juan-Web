@model ContactMessageViewModel
@inject AppDbContext DbContext
@{
    ViewData["Title"] = "Contact";
    var footerSettings = await DbContext.SiteFooterSettings.AsNoTracking().FirstOrDefaultAsync(item => item.Id == 1) ?? new SiteFooterSettings();
    var footerPhoneHref = new string(footerSettings.Phone.Where(item => char.IsDigit(item) || item == '+').ToArray());
}

@await Html.PartialAsync("_StoreHeader")

<section class="contact-hero">
    <div class="container">
        <div class="contact-hero-inner">
            <p>Juan support</p>
            <h1>Contact Us</h1>
            <span>Questions about products, orders, or store details go straight to the admin panel.</span>
        </div>
    </div>
</section>

<section class="contact-area section-padding contact-page">
    <div class="container">
        <div class="row">
            <div class="col-lg-5">
                <div class="contact-info-panel">
                    <p class="contact-label">Store Desk</p>
                    <h2>We usually answer within one business day.</h2>
                    <ul>
                        <li><strong>Email</strong><a href="mailto:@footerSettings.Email">@footerSettings.Email</a></li>
                        <li><strong>Phone</strong><a href="tel:@footerPhoneHref">@footerSettings.Phone</a></li>
                        <li><strong>Address</strong><span>@footerSettings.Address</span></li>
                    </ul>
                </div>
            </div>
            <div class="col-lg-7">
                <div class="contact-message contact-form-panel">
                    @if (TempData["ContactMessage"] is string contactMessage)
                    {
                        <div class="contact-alert">@contactMessage</div>
                    }
                    <div class="row">
                        <div class="col-md-6 mb-30">
                            <button class="contact-action-card text-left h-100 w-100" type="button" data-toggle="modal" data-target="#supportComplaintModal">
                                <p class="contact-label">Complaint</p>
                                <h2>Technical support complaint</h2>
                                <span>Send a message to the technical support queue.</span>
                            </button>
                        </div>
                        <div class="col-md-6 mb-30">
                            <a class="contact-action-card text-left h-100 w-100" asp-controller="Home" asp-action="SupportChat">
                                <p class="contact-label">Support</p>
                                <h2>Technical support</h2>
                                <span>Open the simulated technical support chat.</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="modal contact-complaint-modal" id="supportComplaintModal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <p class="contact-label">Complaint</p>
                    <h5 class="modal-title">Technical support complaint</h5>
                </div>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <form asp-controller="Home" asp-action="Contact" method="post" data-complaint-form>
                <div class="modal-body contact-message">
                    <p class="complaint-modal-text">Describe the problem and the support team will review it from the admin messages panel.</p>
                    <div asp-validation-summary="ModelOnly" class="contact-error"></div>
                    <div class="row">
                        <div class="col-md-6">
                            <input asp-for="Name" placeholder="Name" required maxlength="120" />
                            <span asp-validation-for="Name" class="contact-error"></span>
                        </div>
                        <div class="col-md-6">
                            <input asp-for="Email" type="email" placeholder="Email" required maxlength="180" />
                            <span asp-validation-for="Email" class="contact-error"></span>
                        </div>
                        <div class="col-12">
                            <textarea asp-for="Message" rows="7" placeholder="Message" required maxlength="1000"></textarea>
                            <span asp-validation-for="Message" class="contact-error"></span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-sqr" type="submit">Send complaint</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var complaintForm = document.querySelector("[data-complaint-form]");

            if (complaintForm) {
                complaintForm.addEventListener("submit", function (event) {
                    if (!complaintForm.checkValidity()) {
                        event.preventDefault();
                        event.stopImmediatePropagation();
                        document.body.classList.remove("page-leave");
                        complaintForm.classList.add("was-validated");
                        complaintForm.reportValidity();
                    }
                }, true);
            }

            if (@(ViewBag.OpenComplaintModal == true ? "true" : "false") && window.jQuery && window.jQuery.fn.modal) {
                window.jQuery("#supportComplaintModal").modal("show");
            }
        });
    </script>
}
