@model HomeViewModel
@{
    ViewData["Title"] = "Home";
}

<partial name="_StoreHeader" />

<section class="hero-slider">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="hero-slider-active slick-arrow-style slick-arrow-style_hero slick-dot-style">
                    @foreach (var slider in Model.Sliders)
                    {
                        <div class="hero-single-slide">
                            <div class="hero-slider-item bg-img" data-bg="@slider.ImageUrl">
                                <div class="hero-slider-content slide-1">
                                    <h5 class="slide-subtitle">@slider.Subtitle</h5>
                                    <h2 class="slide-title">@slider.Title</h2>
                                    <p class="slide-desc">@slider.Description</p>
                                    <a href="@slider.ButtonUrl" class="btn btn-hero">@slider.ButtonText</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<section class="service-policy-area">
    <div class="container">
        <div class="row">
            <div class="col-lg-4">
                <div class="service-policy-item mt-30 bg-1">
                    <div class="policy-icon"><img src="~/main assets/img/icon/policy-1.png" alt="policy icon" /></div>
                    <div class="policy-content">
                        <h5 class="policy-title">FREE SHIPPING</h5>
                        <p class="policy-desc">Free shipping on all order</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="service-policy-item mt-30 bg-2">
                    <div class="policy-icon"><img src="~/main assets/img/icon/policy-2.png" alt="policy icon" /></div>
                    <div class="policy-content">
                        <h5 class="policy-title">ONLINE SUPPORT</h5>
                        <p class="policy-desc">Online support 24 hours a day</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="service-policy-item mt-30 bg-3">
                    <div class="policy-icon"><img src="~/main assets/img/icon/policy-3.png" alt="policy icon" /></div>
                    <div class="policy-content">
                        <h5 class="policy-title">MONEY RETURN</h5>
                        <p class="policy-desc">Back guarantee under 5 days</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="our-product section-padding">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="section-title text-center">
                    <h2 class="title">Our Product</h2>
                    <p class="sub-title">Lorem ipsum dolor sit amet consectetur adipisicing</p>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                <div class="product-carousel-4 mbn-50 slick-row-15 slick-arrow-style">
                    @foreach (var product in Model.Products)
                    {
                        var imageUrl = string.IsNullOrWhiteSpace(product.ImageUrl) ? Url.Content("~/main assets/img/product/product-1.jpg") : product.ImageUrl;
                        var categories = string.Join(", ", product.ProductCategories.Select(productCategory => productCategory.Category.Name));
                        var description = string.IsNullOrWhiteSpace(product.Description) ? "No description available." : product.Description;
                        var isOutOfStock = product.StockCount < 1;
                        <div class="product-item mb-50 @(isOutOfStock ? "is-out-of-stock" : "")"
                             data-product-card
                             data-product-id="@product.Id"
                             data-product-name="@product.Name"
                             data-product-price="@product.Price.ToString("C")"
                             data-product-image="@imageUrl"
                             data-product-description="@description"
                             data-product-categories="@categories"
                             data-product-stock="@product.StockCount"
                             data-product-out-of-stock="@isOutOfStock.ToString().ToLowerInvariant()">
                            <div class="product-thumb">
                                <a href="#" data-product-quick-view><img src="@imageUrl" alt="@product.Name" /></a>
                                @if (isOutOfStock)
                                {
                                    <span class="product-stock-badge">Out of stock</span>
                                }
                            </div>
                            <div class="product-content">
                                <h5 class="product-name"><a href="#" data-product-quick-view>@product.Name</a></h5>
                                <div class="price-box">
                                    <span class="price-regular">@product.Price.ToString("C")</span>
                                </div>
                                <p>@categories</p>
                                @if (!isOutOfStock)
                                {
                                    <div class="product-action-link">
                                        <a href="#" data-shop-action="wishlist" data-no-transition data-toggle="tooltip" title="Wishlist"><i class="fa fa-heart-o"></i></a>
                                        <a href="#" data-shop-action="basket" data-no-transition data-toggle="tooltip" title="Add To Cart"><i class="fa fa-shopping-bag"></i></a>
                                        <a href="#" data-product-quick-view data-no-transition data-toggle="tooltip" title="Quick View"><i class="fa fa-eye"></i></a>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<div class="banner-statistics">
    <div class="container">
        <div class="row no-gutters mtn-30">
            <div class="col-md-6">
                <div class="img-container mt-30">
                    <a asp-controller="Products" asp-action="Index">
                        <img src="~/main assets/img/banner/banner-1.jpg" alt="banner-image" />
                    </a>
                    <div class="banner-text">
                        <h5 class="banner-subtitle">sports shoes</h5>
                        <h3 class="banner-title">20% Off<br />For Sports men</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="img-container mt-30">
                    <a asp-controller="Products" asp-action="Index">
                        <img src="~/main assets/img/banner/banner-2.jpg" alt="banner-image" />
                    </a>
                    <div class="banner-text">
                        <h5 class="banner-subtitle">sports shoes</h5>
                        <h3 class="banner-title">20% Off<br />For Sports men</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="brand-area section-padding">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="brand-active-carousel">
                    <div class="brand-item"><a href="#"><img src="~/main assets/img/brand/br1.png" alt="brand" /></a></div>
                    <div class="brand-item"><a href="#"><img src="~/main assets/img/brand/br2.png" alt="brand" /></a></div>
                    <div class="brand-item"><a href="#"><img src="~/main assets/img/brand/br3.png" alt="brand" /></a></div>
                    <div class="brand-item"><a href="#"><img src="~/main assets/img/brand/br4.png" alt="brand" /></a></div>
                    <div class="brand-item"><a href="#"><img src="~/main assets/img/brand/br5.png" alt="brand" /></a></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal" id="quick_view">
    <div class="modal-dialog modal-lg modal-dialog-centered product-modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="product-details-inner">
                    <div class="row">
                        <div class="col-lg-5">
                            <div class="product-large-slider mb-20">
                                <div class="pro-large-img img-zoom">
                                    <img src="~/main assets/img/product/product-details-img1.jpg" alt="product" data-modal-product-image />
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-7">
                            <div class="product-details-des">
                                <h3 class="pro-det-title" data-modal-product-name>Primitive Mens Premium Shoes</h3>
                                <div class="price-box">
                                    <span class="regular-price" data-modal-product-price>$70.00</span>
                                </div>
                                <p data-modal-product-description>Lorem ipsum dolor sit amet, consetetur sadipscing elitr.</p>
                                <div class="product-modal-meta">
                                    <span><strong>Category</strong> <span data-modal-product-categories>-</span></span>
                                    <span><strong>Stock</strong> <span data-modal-product-stock>-</span></span>
                                </div>
                                <form asp-controller="Home" asp-action="AddToCart" method="post" class="quantity-cart-box product-modal-cart" data-modal-basket-form data-no-transition>
                                    <input type="hidden" name="productId" value="" data-modal-product-id />
                                    <div class="quantity">
                                        <div class="pro-qty">
                                            <input type="text" name="quantity" value="1" inputmode="numeric" pattern="[0-9]*" autocomplete="off" title="Only whole numbers from 1 to 99 are allowed" data-quantity-limit />
                                        </div>
                                    </div>
                                    <button class="btn btn-default" type="submit">Add To Cart</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    #quick_view .product-modal-dialog{max-width:940px}
    #quick_view .modal-content{border:0;border-radius:10px;box-shadow:0 22px 55px rgba(20,20,20,.22);overflow:hidden}
    #quick_view .modal-header{position:absolute;right:18px;top:14px;z-index:3;border:0;padding:0}
    #quick_view .modal-header .close{width:38px;height:38px;border-radius:50%;background:#fff;box-shadow:0 8px 22px rgba(0,0,0,.12);font-size:28px;font-weight:300;line-height:38px;opacity:1}
    #quick_view .modal-body{padding:28px}
    #quick_view .product-details-inner>.row{align-items:flex-start}
    #quick_view .product-large-slider{position:sticky;top:20px;margin:0;background:#f8f8f8;border:1px solid #eeeeee;border-radius:8px;overflow:hidden}
    #quick_view .pro-large-img{height:430px;display:flex;align-items:center;justify-content:center;padding:28px;background:linear-gradient(180deg,#fff 0%,#f7f7f7 100%)}
    #quick_view .pro-large-img img{max-width:100%;max-height:100%;object-fit:contain}
    #quick_view .product-details-des{padding:4px 0 0 14px}
    #quick_view .pro-det-title{font-size:28px;line-height:1.18;margin:0 44px 12px 0;color:#252525}
    #quick_view .regular-price{display:inline-block;color:#b98521;font-size:22px;font-weight:800;margin-bottom:12px}
    #quick_view [data-modal-product-description]{font-size:16px;line-height:1.7;color:#4c4c4c;margin-bottom:18px}
    .product-modal-meta{display:flex;flex-wrap:wrap;gap:10px;margin:0 0 18px}
    .product-modal-meta span{display:inline-flex;align-items:center;gap:6px;background:#f8f8f8;border:1px solid #eeeeee;border-radius:999px;padding:8px 12px;color:#444;font-size:14px}
    .product-modal-meta strong{color:#222}
    .product-modal-cart{display:flex;align-items:center;gap:14px;margin:0}
    .product-modal-cart .quantity{margin:0}
    .product-modal-cart .pro-qty{border:1px solid #e0e0e0;border-radius:6px;background:#fff;height:46px}
    .product-modal-cart .pro-qty input{height:44px}
    .product-modal-cart .btn{height:46px;border-radius:6px;padding:0 28px;font-weight:800;letter-spacing:.02em}
    @@media (max-width: 991px){
        #quick_view .product-details-des{padding:22px 0 0}
        #quick_view .pro-large-img{height:320px}
        #quick_view .product-large-slider{position:static}
    }
    @@media (max-width: 575px){
        #quick_view .modal-body{padding:18px}
        #quick_view .pro-det-title{font-size:22px}
        .product-modal-cart{align-items:stretch;flex-direction:column}
        .product-modal-cart .btn{width:100%}
    }
</style>

@section Scripts {
    <script>
        (function () {
            var modal = document.getElementById("quick_view");
            var cards = document.querySelectorAll("[data-product-card]");

            cards.forEach(function (card) {
                card.addEventListener("click", function (event) {
                    if (card.dataset.productOutOfStock === "true") {
                        event.preventDefault();
                        return;
                    }

                    var ignoredAction = event.target.closest(".product-action-link a:not([data-product-quick-view])");

                    if (ignoredAction) {
                        return;
                    }

                    event.preventDefault();
                    fillProductModal(card);

                    if (window.jQuery && window.jQuery.fn.modal) {
                        window.jQuery(modal).modal("show");
                    }
                });
            });

            function fillProductModal(card) {
                setText("[data-modal-product-name]", card.dataset.productName);
                setText("[data-modal-product-price]", card.dataset.productPrice);
                setText("[data-modal-product-description]", card.dataset.productDescription);
                setText("[data-modal-product-categories]", card.dataset.productCategories || "-");
                setText("[data-modal-product-stock]", card.dataset.productStock ? card.dataset.productStock + " item(s)" : "-");

                var productId = modal.querySelector("[data-modal-product-id]");
                if (productId) {
                    productId.value = card.dataset.productId || "";
                }

                var quantityInput = modal.querySelector("[data-quantity-limit]");
                if (quantityInput) {
                    quantityInput.value = "1";
                    quantityInput.dataset.maxQuantity = String(Math.min(parseInt(card.dataset.productStock, 10) || 1, 99));
                }

                var image = modal.querySelector("[data-modal-product-image]");
                if (image) {
                    image.src = card.dataset.productImage;
                    image.alt = card.dataset.productName;
                }
            }

            function setText(selector, value) {
                var element = modal.querySelector(selector);
                if (element) {
                    element.textContent = value || "";
                }
            }

            modal.addEventListener("input", function (event) {
                if (!event.target.matches("[data-quantity-limit]")) {
                    return;
                }

                event.target.value = event.target.value.replace(/\D/g, "");
                var maxQuantity = parseInt(event.target.dataset.maxQuantity, 10) || 99;
                var value = parseInt(event.target.value, 10);

                if (value > maxQuantity) {
                    event.target.value = String(maxQuantity);
                }
            });

            modal.addEventListener("change", function (event) {
                if (!event.target.matches("[data-quantity-limit]")) {
                    return;
                }

                normalizeQuantity(event.target);
            });

            modal.addEventListener("submit", function (event) {
                var input = event.target.querySelector("[data-quantity-limit]");
                if (!input) {
                    return;
                }

                normalizeQuantity(input);
            });

            function normalizeQuantity(input) {
                var maxQuantity = parseInt(input.dataset.maxQuantity, 10) || 99;
                var value = parseInt(input.value, 10);
                if (!value || value < 1) {
                    input.value = "1";
                    return;
                }

                if (value > maxQuantity) {
                    input.value = String(maxQuantity);
                }
            }
        })();
    </script>
}
